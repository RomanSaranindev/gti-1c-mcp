node_modules/
.env
*.log
*.log.*.gz
server_logs.txt

# Резервные копии расширения 1С
*.cfe.backup
*.cfe.bak*

# Сертификаты и приватные ключи — НИКОГДА не коммитить.
# Правило cert/* (а не cert/), иначе git не заходит внутрь папки
# и исключение ниже не срабатывает.
cert/*
*.pfx
*.p12
*.key
*.cer
*.crt
*.pem

# Исключение: бандл доверенных корневых сертификатов (HG Root CA + HG Issuing CA).
# Секретов не содержит — только публичные части, нужные для строгой проверки TLS.
# Хранится в репозитории, чтобы после clone подключение к 1С работало сразу.
#
# Строка идёт ПОСЛЕ *.pem: в gitignore побеждает последнее совпавшее правило,
# поэтому исключение, поставленное выше маски, не сработало бы.
!cert/hg-ca-bundle.pem

# Реестр персональных токенов доступа
tokens.json

# Рабочие заметки сессий агента — не часть кодовой базы
handoffs/



# Исходные данные с персональной информацией — не коммитить
Employee database.xlsx
*.xlsx
*.xls

# Python
__pycache__/
*.pyc
*.pyo
py_proxy/venv/
