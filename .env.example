# ================================================================
# gti-1c-mcp — переменные окружения
# Скопируйте в .env и заполните
# ================================================================

# Порт HTTP-сервера (по умолчанию 3031)
MCP_PORT=3031

# Токен авторизации — ОБЯЗАТЕЛЬНО смените!
MCP_API_TOKEN=gti-mcp-token-2024

# Путь к папке с инструкциями (по умолчанию knowledge/instructions рядом с src/)
# KNOWLEDGE_DIR=/custom/path/to/instructions

# ================================================================
# Подключение к рабочей базе 1С (опционально)
# Требует установленного расширения build/MCP_Сервер.cfe в базу 1С
# и опубликованного HTTP-сервиса через Apache/IIS
# ================================================================

# URL опубликованной базы 1С, например: http://server/base
# (регистр имени базы должен совпадать с именем публикации!)
ONEC_URL=http://localhost/base

# Логин пользователя 1С (технический пользователь с минимальными правами)
ONEC_USERNAME=admin

# Пароль пользователя 1С
ONEC_PASSWORD=

# Корень HTTP-сервиса в расширении (по умолчанию mcp, не менять без необходимости)
# ONEC_SERVICE_ROOT=mcp

# Таймаут запросов к 1С в миллисекундах (по умолчанию 30000)
# ONEC_TIMEOUT=30000
