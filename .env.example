# ================================================================
# gti-1c-mcp — переменные окружения
# Скопируйте в .env и заполните
# ================================================================

# Порт HTTP-сервера
MCP_PORT=3031

# ================================================================
# Ключ шифрования (обязателен)
# ================================================================
# Этим ключом шифруются пароли 1С в tokens.json.
# Сгенерировать: node tools/token.mjs genkey
# ВАЖНО: при смене ключа все выданные токены перестанут работать.
MCP_SECRET_KEY=

# ================================================================
# Подключение к рабочей базе 1С
# Требует расширения build/MCP_Сервер.cfe и публикации HTTP-сервиса
# ================================================================

# URL опубликованной базы, например https://server/base
# (регистр имени базы должен совпадать с именем публикации!)
ONEC_URL=

# Резервные учётные данные — используются в stdio-режиме и для health-check.
# При работе по HTTP запрос к 1С идёт под доменной учёткой владельца токена,
# поэтому права и RLS применяются к нему, а не к общей технической учётке.
ONEC_USERNAME=
ONEC_PASSWORD=

# Доверенные корневые сертификаты для строгой проверки TLS.
# По умолчанию берётся cert/hg-ca-bundle.pem — задавать не нужно.
# ONEC_CA_BUNDLE=/путь/к/ca-bundle.pem

# Корень HTTP-сервиса в расширении (менять не нужно)
# ONEC_SERVICE_ROOT=mcp

# Таймаут запросов к 1С, мс. Жёсткий дедлайн запроса = 2x этого значения
# ONEC_TIMEOUT=30000

# Повторы при транзиентных сбоях (сеть, таймаут, HTTP 5xx)
# ONEC_RETRY_ATTEMPTS=2
# ONEC_RETRY_DELAY=500

# Общий дедлайн для get_1c_metadata, мс
# ONEC_TOOL_DEADLINE=60000

# ================================================================
# Прочее
# ================================================================

# Путь к папке с инструкциями (по умолчанию knowledge/instructions)
# KNOWLEDGE_DIR=

# Путь к реестру токенов (по умолчанию tokens.json в корне проекта)
# MCP_TOKENS_FILE=

# Транспорт: http (по умолчанию) или stdio.
# Можно также передать флаг --stdio в командной строке.
# MCP_TRANSPORT=http

# Сессии MCP
# MCP_SESSION_TTL=1800000
# MCP_SESSION_SWEEP=300000
# MCP_MAX_SESSIONS=100
