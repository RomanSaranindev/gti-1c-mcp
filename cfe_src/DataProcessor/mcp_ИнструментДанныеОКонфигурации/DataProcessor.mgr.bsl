		СхемаПараметров
	);

КонецПроцедуры

Функция ВыполнитьGetDocuments(Аргументы)

	ТипДок = СокрЛП(?(Аргументы.Свойство("document_type"), Аргументы.document_type, ""));
	Если Не ЗначениеЗаполнено(ТипДок) Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "MissingParameter");
		Итог.Вставить("message", "Необходимо указать document_type.");
		Итог.Вставить("hint",    "Получить список типов: list_metadata_objects с metaType='Документы'.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	// Нормализуем имя: принимаем 'ПутевойЛист' и 'Документ.ПутевойЛист'
	Если СтрНачинаетсяС(НРег(ТипДок), "документ.") Тогда
		ТипДок = Сред(ТипДок, 10);
	КонецЕсли;

	МетаДок = Метаданные.Документы.Найти(ТипДок);
	Если МетаДок = Неопределено Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",         "DocumentTypeNotFound");
		Итог.Вставить("document_type", ТипДок);
		Итог.Вставить("message",       "Тип документа не найден в метаданных: " + ТипДок);
		Итог.Вставить("hint",          "Проверьте имя через list_metadata_objects (metaType='Документы').");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	Лимит = Цел(ЧислоИзЗначения(?(Аргументы.Свойство("limit"), Аргументы.limit, 50), 50));
	Если Лимит <= 0 Или Лимит > 500 Тогда
		Лимит = 50;
	КонецЕсли;

	ДатаС    = ДатаИзСтроки(СокрЛП(?(Аргументы.Свойство("date_from"), Аргументы.date_from, "")));
	ДатаПо   = ДатаИзСтроки(СокрЛП(?(Аргументы.Свойство("date_to"),   Аргументы.date_to,   "")));
	Если ЗначениеЗаполнено(ДатаПо) Тогда
		ДатаПо = КонецДня(ДатаПо);
	КонецЕсли;
	Статус   = СокрЛП(?(Аргументы.Свойство("status"),       Аргументы.status,       ""));
	Контраг  = СокрЛП(?(Аргументы.Свойство("counterparty"), Аргументы.counterparty, ""));

	// Определяем наличие опциональных реквизитов у данного типа
	ЕстьОрганизация = МетаДок.Реквизиты.Найти("Организация") <> Неопределено;
	ЕстьКонтрагент  = МетаДок.Реквизиты.Найти("Контрагент")  <> Неопределено;
	ЕстьСумма       = МетаДок.Реквизиты.Найти("СуммаДокумента") <> Неопределено;
	Если Не ЕстьСумма Тогда
		ЕстьСумма = МетаДок.Реквизиты.Найти("Сумма") <> Неопределено;
		ИмяСуммы  = "Сумма";
	Иначе
		ИмяСуммы  = "СуммаДокумента";
	КонецЕсли;

	// Собираем список выбираемых полей
	Поля = Новый Массив;
	Поля.Добавить("	Док.Номер                КАК Номер");
	Поля.Добавить("	Док.Дата                 КАК Дата");
	Поля.Добавить("	Док.Проведен             КАК Проведен");
	Поля.Добавить("	Док.ПометкаУдаления      КАК ПометкаУдаления");
	Если ЕстьОрганизация Тогда
		Поля.Добавить("	ЕСТЬNULL(Док.Организация.Наименование, """") КАК Организация");
	КонецЕсли;
	Если ЕстьКонтрагент Тогда
		Поля.Добавить("	ЕСТЬNULL(Док.Контрагент.Наименование, """")  КАК Контрагент");
	КонецЕсли;
	Если ЕстьСумма Тогда
		Поля.Добавить("	ЕСТЬNULL(Док." + ИмяСуммы + ", 0) КАК Сумма");
	КонецЕсли;

	// Условия
	Условия = Новый Массив;
	Условия.Добавить("(&БезДатыС  ИЛИ Док.Дата >= &ДатаС)");
	Условия.Добавить("(&БезДатыПо ИЛИ Док.Дата <= &ДатаПо)");
	Условия.Добавить("(&БезСтатуса"
		+ " ИЛИ (&СтатусПроведен    И Док.Проведен И НЕ Док.ПометкаУдаления)"
		+ " ИЛИ (&СтатусНеПроведен  И НЕ Док.Проведен И НЕ Док.ПометкаУдаления)"
		+ " ИЛИ (&СтатусПомечен     И Док.ПометкаУдаления))");
	Если ЕстьКонтрагент Тогда
		Условия.Добавить("(&БезКонтрагента ИЛИ Док.Контрагент.Наименование ПОДОБНО &ШаблонКонтрагента)");
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ СтрСоединить(Поля, "," + Символы.ПС) + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	Документ." + ТипДок + " КАК Док" + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ "	" + СтрСоединить(Условия, Символы.ПС + "	И ") + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО" + Символы.ПС
		+ "	Док.Дата УБЫВ";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("БезДатыС",  Не ЗначениеЗаполнено(ДатаС));
	Запрос.УстановитьПараметр("ДатаС",     ДатаС);
	Запрос.УстановитьПараметр("БезДатыПо", Не ЗначениеЗаполнено(ДатаПо));
	Запрос.УстановитьПараметр("ДатаПо",    ДатаПо);
	Запрос.УстановитьПараметр("БезСтатуса",       Не ЗначениеЗаполнено(Статус));
	Запрос.УстановитьПараметр("СтатусПроведен",   Статус = "Проведён" Или Статус = "Проведен");
	Запрос.УстановитьПараметр("СтатусНеПроведен", Статус = "НеПроведён" Или Статус = "НеПроведен");
	Запрос.УстановитьПараметр("СтатусПомечен",    Статус = "Помечен");
	Если ЕстьКонтрагент Тогда
		Запрос.УстановитьПараметр("БезКонтрагента",   Не ЗначениеЗаполнено(Контраг));
		Запрос.УстановитьПараметр("ШаблонКонтрагента", "%" + Контраг + "%");
	КонецЕсли;

	Попытка
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		Итог = Новый Соответствие;
		Итог.Вставить("error",         "QueryError");
		Итог.Вставить("document_type", ТипДок);
		Итог.Вставить("message",       ОписаниеОшибки());
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецПопытки;

	СинонимТипа = ?(ЗначениеЗаполнено(МетаДок.Синоним), МетаДок.Синоним, ТипДок);

	Массив = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Мап = Новый Соответствие;
		Мап.Вставить("number",        СокрЛП(Строка(Стр.Номер)));
		Мап.Вставить("date",          ?(ЗначениеЗаполнено(Стр.Дата),
		                                Формат(Стр.Дата, "ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""), ""));
		Мап.Вставить("is_posted",     Стр.Проведен);
		Мап.Вставить("is_deleted",    Стр.ПометкаУдаления);
		Мап.Вставить("document_type", СинонимТипа);
		Если ЕстьОрганизация Тогда
			Мап.Вставить("organization", Стр.Организация);
		КонецЕсли;
		Если ЕстьКонтрагент Тогда
			Мап.Вставить("counterparty", Стр.Контрагент);
		КонецЕсли;
		Если ЕстьСумма Тогда
			Мап.Вставить("amount", Число(Стр.Сумма));
		КонецЕсли;
		Массив.Добавить(Мап);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("document_type",   ТипДок);
	Итог.Вставить("document_synonym", СинонимТипа);
	Итог.Вставить("documents_count", Массив.Количество());
	Итог.Вставить("documents",       Массив);
	Итог.Вставить("limit",           Лимит);
	Итог.Вставить("fields_available", Новый Структура(
		"organization, counterparty, amount",
		ЕстьОрганизация, ЕстьКонтрагент, ЕстьСумма));
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

#КонецОбласти

#Область Инструмент_check_document_access

// ─── Инструмент check_document_access ─────────────────────────────────────────
//
// Отвечает рядовому сотруднику на вопрос «каких прав мне не хватает,
// чтобы работать с документом X».
//
// Проверяются права Чтение / Добавление / Изменение / Проведение / ПометкаУдаления
// на объект метаданных документа. Для недостающих прав подбираются профили
// групп доступа, которые эти права дают — их сотрудник и запрашивает у администратора.
//
// Безопасность:
//   * без user_uid проверяется ТЕКУЩИЙ пользователь сеанса. Сервер выполняет
//     запрос под доменной учёткой владельца токена, поэтому рядовой сотрудник
//     получает ответ только про себя и не может «просветить» коллегу;
//   * user_uid разрешён только ролям analyst/admin — это контролирует MCP-сервер
//     (см. TOOL_ACCESS и обработчик check_document_access в server.js);
//   * ФИО не передаётся ни во входе, ни в ответе.
//

Процедура ЗарегистрироватьИнструментCheckDocumentAccess(ТаблицаИнструментов)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"document_type", "string",
		"Имя типа документа в метаданных 1С, например 'бит_ЗаявкаНаРасходованиеСредств' или"
		+ " 'Документ.ПутевойЛист'. Получить список: list_metadata_objects с metaType='Documents'.",
		, Истина));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"user_uid", "string",
		"ИдентификаторПользователяИБ проверяемого сотрудника (UUID с дефисами)."
		+ " Не указывать — проверяются права ТЕКУЩЕГО пользователя сеанса."
		+ " Диагностика другого сотрудника доступна только ролям analyst и admin.",
		""));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"suggest_profiles", "string",
		"true (по умолчанию) — подобрать профили групп доступа, дающие недостающие права;"
		+ " false — вернуть только перечень прав.",
		"true", , "true,false"));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	mcp_Метаданные.ДобавитьИнструмент(
		ТаблицаИнструментов,
		"check_document_access",
		"Проверяет, каких прав не хватает сотруднику для работы с документом указанного типа."
		+ " Возвращает по каждому праву (Чтение, Добавление, Изменение, Проведение, ПометкаУдаления)"
		+ " признак наличия, а для недостающих — профили групп доступа, которые это право дают."
		+ " Без user_uid проверяется текущий пользователь сеанса. ФИО не передаётся.",
		СхемаПараметров
	);

КонецПроцедуры

// Список проверяемых прав: имя права в платформе и его русское представление.
// Ограничен правами, которые реально нужны рядовому пользователю для работы
// с документом; административные права (Администрирование и т.п.) не проверяем.
Функция ПроверяемыеПраваДокумента()

	Права = Новый Массив;
	Права.Добавить(Новый Структура("Имя, Описание", "Чтение",        "просмотр документов этого типа"));
	Права.Добавить(Новый Структура("Имя, Описание", "Добавление",    "создание новых документов"));
	Права.Добавить(Новый Структура("Имя, Описание", "Изменение",     "редактирование существующих документов"));
	Права.Добавить(Новый Структура("Имя, Описание", "Проведение",    "проведение документа"));
	Права.Добавить(Новый Структура("Имя, Описание", "ПометкаУдаления", "пометка документа на удаление"));

	Возврат Права;

КонецФункции

Функция ВыполнитьCheckDocumentAccess(Аргументы)

	ТипДок = СокрЛП(?(Аргументы.Свойство("document_type"), Аргументы.document_type, ""));
	Если Не ЗначениеЗаполнено(ТипДок) Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "MissingParameter");
		Итог.Вставить("message", "Необходимо указать document_type.");
		Итог.Вставить("hint",    "Например 'бит_ЗаявкаНаРасходованиеДС'."
			+ " Список типов: list_metadata_objects с metaType='Documents'.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	// Принимаем и 'ПутевойЛист', и 'Документ.ПутевойЛист'
	Если СтрНачинаетсяС(НРег(ТипДок), "документ.") Тогда
		ТипДок = Сред(ТипДок, 10);
	КонецЕсли;

	МетаДок = Метаданные.Документы.Найти(ТипДок);
	Если МетаДок = Неопределено Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",         "DocumentTypeNotFound");
		Итог.Вставить("document_type", ТипДок);
		Итог.Вставить("message",       "Тип документа не найден в метаданных: " + ТипДок);
		Итог.Вставить("hint",          "Проверьте имя через list_metadata_objects (metaType='Documents').");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	ПодбиратьПрофили = Истина;
	Если Аргументы.Свойство("suggest_profiles")
		И СокрЛП(НРег(Строка(Аргументы.suggest_profiles))) = "false" Тогда
		ПодбиратьПрофили = Ложь;
	КонецЕсли;

	// Привилегированный режим необходим по двум причинам:
	//   1. ПравоДоступа с явным указанием роли требует административных прав —
	//      без этого вызов у рядового сотрудника завершился бы исключением;
	//   2. Справочники ГруппыДоступа и ПрофилиГруппДоступа закрыты RLS, и рядовой
	//      пользователь увидел бы только свои группы — подбор профилей не работал бы.
	//
	// Это безопасно: наружу отдаются только имена прав и наименования профилей.
	// Ни бизнес-данных, ни ФИО в ответе нет, а диагностика ЧУЖИХ прав (user_uid)
	// разрешена лишь ролям analyst/admin — проверка выполняется на MCP-сервере.
	УстановитьПривилегированныйРежим(Истина);

	// ── Определяем, чьи права проверяем ───────────────────────────────────────
	UIDПольз = СокрЛП(?(Аргументы.Свойство("user_uid"), Аргументы.user_uid, ""));

	Если ЗначениеЗаполнено(UIDПольз) Тогда
		// Явно заданный сотрудник
		РезультатПоиска = НайтиПользователяПоUID(UIDПольз);
		Если РезультатПоиска.Ошибка <> "" Тогда
			Возврат ОтветОбОшибкеПоискаПользователя(РезультатПоиска, UIDПольз, "");
		КонецЕсли;
		СсылкаПользователя = РезультатПоиска.Ссылка;
		ЭтоТекущийПользователь = Ложь;
	Иначе
		// Текущий пользователь сеанса. Сервер обращается к 1С под доменной
		// учёткой владельца токена, поэтому это именно тот, кто задал вопрос.
		ТекущийUID = ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор;
		РезультатПоиска = НайтиПользователяПоUID(Строка(ТекущийUID));
		Если РезультатПоиска.Ошибка <> "" Тогда
			Итог = Новый Соответствие;
			Итог.Вставить("error",   "CurrentUserNotFound");
			Итог.Вставить("message", "Текущий пользователь сеанса не найден в Справочник.Пользователи.");
			Итог.Вставить("hint",    "Обратитесь к администратору: учётная запись ИБ не связана"
				+ " с элементом справочника пользователей.");
			Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
		КонецЕсли;
		СсылкаПользователя = РезультатПоиска.Ссылка;
		ЭтоТекущийПользователь = Истина;
	КонецЕсли;

	// ── Роли, доступные сотруднику через его группы доступа ───────────────────
	РолиПользователя = РолиПользователяПоСсылке(СсылкаПользователя);

	// ── Проверяем каждое право ────────────────────────────────────────────────
	ПраваМассив      = Новый Массив;
	НедостающиеПрава = Новый Массив;
	ЕстьВсеПрава     = Истина;

	Для Каждого ОписаниеПрава Из ПроверяемыеПраваДокумента() Цикл

		// Право может отсутствовать у объекта в принципе (например Проведение
		// у документа, для которого проведение запрещено) — такие пропускаем.
		Если Не ПравоСуществуетДляДокумента(МетаДок, ОписаниеПрава.Имя) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьПраво = ПравоЕстьВРолях(ОписаниеПрава.Имя, МетаДок, РолиПользователя);

		Эл = Новый Соответствие;
		Эл.Вставить("right",       ОписаниеПрава.Имя);
		Эл.Вставить("description", ОписаниеПрава.Описание);
		Эл.Вставить("granted",     ЕстьПраво);
		ПраваМассив.Добавить(Эл);

		Если Не ЕстьПраво Тогда
			ЕстьВсеПрава = Ложь;
			НедостающиеПрава.Добавить(ОписаниеПрава.Имя);
		КонецЕсли;

	КонецЦикла;

	// ── Подбираем профили, дающие недостающие права ───────────────────────────
	ПрофилиМассив = Новый Массив;
	Если ПодбиратьПрофили И НедостающиеПрава.Количество() > 0 Тогда
		ПрофилиМассив = ПрофилиДающиеПрава(МетаДок, НедостающиеПрава);
	КонецЕсли;

	СинонимТипа = ?(ЗначениеЗаполнено(МетаДок.Синоним), МетаДок.Синоним, ТипДок);

	Итог = Новый Соответствие;
	Итог.Вставить("document_type",     ТипДок);
	Итог.Вставить("document_synonym",  СинонимТипа);
	Итог.Вставить("checked_self",      ЭтоТекущийПользователь);
	Итог.Вставить("has_all_rights",    ЕстьВсеПрава);
	Итог.Вставить("rights",            ПраваМассив);
	Итог.Вставить("missing_rights",    НедостающиеПрава);
	Итог.Вставить("roles_count",       РолиПользователя.Количество());

	Если НедостающиеПрава.Количество() > 0 Тогда
		Итог.Вставить("suggested_profiles", ПрофилиМассив);
		Если ПрофилиМассив.Количество() > 0 Тогда
			Итог.Вставить("hint",
				"Запросите у администратора включение в группу доступа с одним из профилей"
				+ " в suggested_profiles. Профили отсортированы по покрытию недостающих прав:"
				+ " первый закрывает больше всего.");
		Иначе
			Итог.Вставить("hint",
				"Ни один профиль в базе не даёт недостающие права на этот документ."
				+ " Обратитесь к администратору — потребуется настройка роли.");
		КонецЕсли;
	Иначе
		Итог.Вставить("hint",
			"Прав на объект достаточно. Если документ всё равно недоступен, причина в"
			+ " ограничении доступа на уровне записей (RLS): организация, ЦФО, склад или"
			+ " подразделение. Проверьте виды доступа групп: get_1c_access_groups.");
	КонецЕсли;

	Итог.Вставить("privacy_note",
		"ФИО не передаётся. Проверка выполнена внутри 1С по ролям групп доступа сотрудника.");
	Итог.Вставить("note",
		"Проверяются права на объект метаданных. Ограничения на уровне записей (RLS)"
		+ " этой проверкой не оцениваются.");

	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

// Проверяет, применимо ли право к данному документу.
//
// У документа с запрещённым проведением право «Проведение» не имеет смысла:
// показывать его как недостающее — вводить пользователя в заблуждение,
// администратор такое право выдать не сможет.
Функция ПравоСуществуетДляДокумента(МетаДок, Знач ИмяПрава)

	Если ИмяПрава = "Проведение" Тогда
		Возврат МетаДок.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;
	КонецЕсли;

	// Остальные проверяемые права определены для любого документа
	Возврат Истина;

КонецФункции

// Проверяет наличие права хотя бы в одной из ролей сотрудника.
//
// Используется ПравоДоступа с явным указанием роли: так проверяются права
// именно этого сотрудника, а не текущего сеанса. Права в 1С складываются
// объединением по всем ролям, поэтому достаточно одной подходящей.
//
// Параметры:
//  ИмяПрава - Строка - имя права платформы
//  МетаДок  - ОбъектМетаданных - документ
//  Роли     - Массив из ОбъектМетаданных - роли сотрудника
//
Функция ПравоЕстьВРолях(Знач ИмяПрава, МетаДок, Роли)

	Для Каждого Роль Из Роли Цикл
		Попытка
			Если ПравоДоступа(ИмяПрава, МетаДок, Роль) Тогда
				Возврат Истина;
			КонецЕсли;
		Исключение
			// Роль расширения или удалённая роль — пропускаем
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает роли (объекты метаданных), доступные сотруднику через его группы доступа.
//
// Источник — Справочник.ГруппыДоступа: ТЧ Пользователи содержит и самих
// пользователей, и группы пользователей, поэтому учитываем оба варианта.
//
// Параметры:
//  СсылкаПользователя - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - роли
//
Функция РолиПользователяПоСсылке(Знач СсылкаПользователя)

	ГруппыПользователя = ГруппыПользователяПоСсылке(СсылкаПользователя);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РолиПрофиля.Роль.Имя КАК ИмяРоли
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК Состав
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК РолиПрофиля
	|		ПО РолиПрофиля.Ссылка = Состав.Ссылка.Профиль
	|ГДЕ
	|	(Состав.Пользователь = &Пользователь
	|		ИЛИ Состав.Пользователь В (&ГруппыПользователя))
	|	И НЕ Состав.Ссылка.ПометкаУдаления
	|	И НЕ Состав.Ссылка.Профиль.ПометкаУдаления
	|	И (Состав.СрокДействия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Состав.СрокДействия >= &ТекущаяДата)");

	Запрос.УстановитьПараметр("Пользователь",       СсылкаПользователя);
	Запрос.УстановитьПараметр("ГруппыПользователя", ГруппыПользователя);
	Запрос.УстановитьПараметр("ТекущаяДата",        НачалоДня(ТекущаяДатаСеанса()));

	Таблица = Запрос.Выполнить().Выгрузить();

	Роли = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Если Не ЗначениеЗаполнено(Стр.ИмяРоли) Тогда
			Продолжить;
		КонецЕсли;
		МетаРоль = Метаданные.Роли.Найти(Стр.ИмяРоли);
		Если МетаРоль <> Неопределено Тогда
			Роли.Добавить(МетаРоль);
		КонецЕсли;
	КонецЦикла;

	Возврат Роли;

КонецФункции

// Подбирает профили групп доступа, роли которых дают недостающие права.
//
// Перебираются профили базы; для каждого проверяется, какие из недостающих прав
// он закрывает. Результат отсортирован по убыванию покрытия — первым идёт
// профиль, закрывающий больше всего.
//
// Параметры:
//  МетаДок          - ОбъектМетаданных - документ
//  НедостающиеПрава - Массив из Строка - имена прав
//
// Возвращаемое значение:
//  Массив из Соответствие - описания профилей
//
Функция ПрофилиДающиеПрава(МетаДок, НедостающиеПрава)

	// Читаем связку профиль → роли одним запросом: перебор через объектную
	// модель на нескольких сотнях профилей был бы заметно дороже.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	РолиПрофиля.Ссылка.Наименование КАК Профиль,
	|	РолиПрофиля.Роль.Имя            КАК ИмяРоли
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК РолиПрофиля
	|ГДЕ
	|	НЕ РолиПрофиля.Ссылка.ПометкаУдаления
	|	И НЕ РолиПрофиля.Ссылка.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Профиль");

	Таблица = Запрос.Выполнить().Выгрузить();

	// Кэш «роль + право → есть/нет»: одна и та же роль входит во множество
	// профилей, а ПравоДоступа — не бесплатный вызов.
	КэшПрав = Новый Соответствие;

	ПрофилиМап    = Новый Соответствие;
	ПорядокКлючей = Новый Массив;

	Для Каждого Стр Из Таблица Цикл

		Если Не ЗначениеЗаполнено(Стр.ИмяРоли) Или Не ЗначениеЗаполнено(Стр.Профиль) Тогда
			Продолжить;
		КонецЕсли;

		МетаРоль = Метаданные.Роли.Найти(Стр.ИмяРоли);
		Если МетаРоль = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ИмяПрава Из НедостающиеПрава Цикл

			КлючКэша = Стр.ИмяРоли + "|" + ИмяПрава;
			ЕстьПраво = КэшПрав[КлючКэша];
			Если ЕстьПраво = Неопределено Тогда
				Попытка
					ЕстьПраво = ПравоДоступа(ИмяПрава, МетаДок, МетаРоль);
				Исключение
					ЕстьПраво = Ложь;
				КонецПопытки;
				КэшПрав.Вставить(КлючКэша, ЕстьПраво);
			КонецЕсли;

			Если Не ЕстьПраво Тогда
				Продолжить;
			КонецЕсли;

			Если ПрофилиМап[Стр.Профиль] = Неопределено Тогда
				ПрофилиМап.Вставить(Стр.Профиль, Новый Массив);
				ПорядокКлючей.Добавить(Стр.Профиль);
			КонецЕсли;
			Если ПрофилиМап[Стр.Профиль].Найти(ИмяПрава) = Неопределено Тогда
				ПрофилиМап[Стр.Профиль].Добавить(ИмяПрава);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	// Сортируем по покрытию: больше закрытых прав — выше
	ТаблицаСортировки = Новый ТаблицаЗначений;
	ТаблицаСортировки.Колонки.Добавить("Профиль");
	ТаблицаСортировки.Колонки.Добавить("Покрытие", Новый ОписаниеТипов("Число"));

	Для Каждого Ключ Из ПорядокКлючей Цикл
		НоваяСтрока = ТаблицаСортировки.Добавить();
		НоваяСтрока.Профиль  = Ключ;
		НоваяСтрока.Покрытие = ПрофилиМап[Ключ].Количество();
	КонецЦикла;
	ТаблицаСортировки.Сортировать("Покрытие Убыв, Профиль Возр");

	// Ограничиваем ответ: полный список профилей базы агенту не нужен,
	// пользователю всё равно запрашивать один из первых.
	МаксПрофилей = 10;

	Результат = Новый Массив;
	Для Каждого Стр Из ТаблицаСортировки Цикл
		Если Результат.Количество() >= МаксПрофилей Тогда
			Прервать;
		КонецЕсли;
		Эл = Новый Соответствие;
		Эл.Вставить("profile",        Стр.Профиль);
		Эл.Вставить("covers_rights",  ПрофилиМап[Стр.Профиль]);
		Эл.Вставить("covers_all",     Стр.Покрытие = НедостающиеПрава.Количество());
		Результат.Добавить(Эл);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
