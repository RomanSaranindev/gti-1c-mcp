#Область get_visa_routes

// Главная функция — диспетчер по режимам
Функция ВыполнитьGetVisaRoutes(Аргументы) Экспорт

	Режим        = ?(Аргументы.Свойство("mode"),          Аргументы.mode,           "visas");
	КодВизы      = ?(Аргументы.Свойство("visa_code"),     Аргументы.visa_code,      "");
	ТипДок       = ?(Аргументы.Свойство("document_type"), Аргументы.document_type,  "");
	ФильтрСтатус = ?(Аргументы.Свойство("status_filter"), Аргументы.status_filter,  "all");
	ДатаНач      = ?(Аргументы.Свойство("date_from"),     Аргументы.date_from,      "");
	ДатаКон      = ?(Аргументы.Свойство("date_to"),       Аргументы.date_to,        "");
	КодАлгоритма = ?(Аргументы.Свойство("algorithm_code"),Аргументы.algorithm_code, "");
	UIDПольз     = СокрЛП(?(Аргументы.Свойство("user_uid"), Аргументы.user_uid, ""));

	// include_groups: по умолчанию true — при отборе по user_uid учитываем
	// и права, выданные группам пользователей, в состав которых входит сотрудник.
	УчитыватьГруппы = Истина;
	Если Аргументы.Свойство("include_groups") И СокрЛП(НРег(Строка(Аргументы.include_groups))) = "false" Тогда
		УчитыватьГруппы = Ложь;
	КонецЕсли;

	// only_active_routes: по умолчанию true — исключаем устаревшие маршруты
	// (те, у которых в бит_НазначениеАлгоритмов заполнена ДатаОкончания)
	ТолькоАктивныеМаршруты = Истина;
	Если Аргументы.Свойство("only_active_routes") И Аргументы.only_active_routes = "false" Тогда
		ТолькоАктивныеМаршруты = Ложь;
	КонецЕсли;

	Лимит = ЧислоИзЗначения(?(Аргументы.Свойство("limit"), Аргументы.limit, 50), 50);
	Если Лимит <= 0 Или Лимит > 200 Тогда
		Лимит = 50;
	КонецЕсли;

	Если Режим = "visas" Тогда
		Возврат ВизыНаДокументах(КодВизы, ТипДок, ФильтрСтатус, ДатаНач, ДатаКон, Лимит, ТолькоАктивныеМаршруты);
	ИначеЕсли Режим = "routes" Тогда
		Возврат МаршрутыАлгоритмов(КодВизы, ТипДок, ДатаНач, ДатаКон, Лимит, КодАлгоритма, ТолькоАктивныеМаршруты);
	ИначеЕсли Режим = "rights" Тогда
		Возврат ПраваУстановкиВиз(КодВизы, Лимит, UIDПольз, УчитыватьГруппы);
	ИначеЕсли Режим = "algorithm" Тогда
		Возврат ШагиАлгоритма(КодАлгоритма, Лимит);
	ИначеЕсли Режим = "route_graph" Тогда
		Возврат ГрафМаршрута(КодАлгоритма, ТипДок, Лимит);
	КонецЕсли;

	ВызватьИсключение "Неизвестный режим get_visa_routes: " + Режим;

КонецФункции

// ─── Режим visas ─────────────────────────────────────────────────────────────
//
// Возвращает визы, установленные на документах.
// ФИО НЕ передаётся — только Должность (строка).
//
Функция ВизыНаДокументах(КодВизы, ТипДок, ФильтрСтатус, ДатаНачСтр, ДатаКонСтр, Лимит, ТолькоАктивныеМаршруты = Истина)

	// Фильтр по типу документа делается ПОСЛЕ выборки (тип определяется только
	// через Метаданные()), поэтому из базы читаем с запасом, а лимит применяем
	// к уже отфильтрованному результату.
	ЗапасЗаписей = ?(ЗначениеЗаполнено(ТипДок), Лимит * 20, Лимит);
	Если ЗапасЗаписей > 4000 Тогда
		ЗапасЗаписей = 4000;
	КонецЕсли;

	// ВАЖНО: ФИО пользователя не передаётся — только UID (ИдентификаторПользователяИБ).
	// UID уникален для каждого объекта и каждой базы. Для деанонимизации требуется
	// прямой доступ к базе — LLM этого сделать не может.
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	Визы.Объект                                    КАК Объект,
	|	Визы.ИД                                        КАК ИД,
	|	ЕСТЬNULL(Визы.Виза.Наименование, """")         КАК ВизаНаименование,
	|	ЕСТЬNULL(Визы.Виза.Кодификатор, """")          КАК ВизаКод,
	|	ПРЕДСТАВЛЕНИЕ(Визы.Виза.Вид)                   КАК ВизаВид,
	|	ЕСТЬNULL(Визы.Виза.Литера, """")               КАК ВизаЛитера,
	|	ЕСТЬNULL(Визы.Должность, """")                 КАК Должность,
	|	ЕСТЬNULL(Визы.Пользователь.ИдентификаторПользователяИБ, &ПустойUID) КАК ПользовательUID,
	|	ЕСТЬNULL(Визы.Статус.Наименование, """")       КАК СтатусНаименование,
	|	ПРЕДСТАВЛЕНИЕ(Визы.Статус.ТипСтатуса)          КАК СтатусТип,
	|	ЕСТЬNULL(Визы.Решение.Наименование, """")      КАК РешениеНаименование,
	|	ПРЕДСТАВЛЕНИЕ(Визы.Решение.ТипРешения)         КАК РешениеТип,
	|	ЕСТЬNULL(Визы.Маршрут, """")                   КАК Маршрут,
	|	ЕСТЬNULL(Визы.Алгоритм.Наименование, """")     КАК АлгоритмНаименование,
	|	ЕСТЬNULL(Визы.Алгоритм.Код, """")              КАК АлгоритмКод,
	|	ЕСТЬNULL(Визы.ТочкаАлгоритма.Наименование, """") КАК ТочкаАлгоритма,
	|	ЕСТЬNULL(Визы.ТочкаАлгоритма.КодТочки, """")   КАК ТочкаКод,
	|	ЕСТЬNULL(Визы.ТочкаАлгоритма.ИдентификаторТочки, 0) КАК ТочкаИдентификатор,
	|	ЕСТЬNULL(Визы.КодСортировки, 0)                КАК КодСортировки,
	|	Визы.ДатаУстановки                             КАК ДатаУстановки,
	|	Визы.ДатаКрайняя                               КАК ДатаКрайняя,
	|	ЕСТЬNULL(Визы.ВремяНаУстановку, 0)             КАК ВремяНаУстановку,
	|	ЕСТЬNULL(Визы.ПодписанЭП, ЛОЖЬ)                КАК ПодписанЭП,
	|	ЕСТЬNULL(Визы.ЭПДействительна, ЛОЖЬ)           КАК ЭПДействительна,
	|	ЕСТЬNULL(Визы.АктивнаяВиза, ЛОЖЬ)              КАК АктивнаяВиза,
	|	ЕСТЬNULL(Визы.ДобавленаВручную, ЛОЖЬ)          КАК ДобавленаВручную,
	|	ЕСТЬNULL(Визы.КомментарийИИ, """")             КАК КомментарийИИ
	|ИЗ
	|	РегистрСведений.бит_УстановленныеВизы КАК Визы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НазначениеАлгоритмов КАК НА
	|		ПО НА.Алгоритм = Визы.Алгоритм
	|			И НА.ВидАлгоритма = ЗНАЧЕНИЕ(Перечисление.бит_ВидыАлгоритмов.Визирование)
	|ГДЕ
	|	НЕ Визы.Виза.ПометкаУдаления
	|	И (&КодВизыПуст
	|		ИЛИ Визы.Виза.Литера = &КодВизы
	|		ИЛИ Визы.Виза.Кодификатор = &КодВизы
	|		ИЛИ (&ИскатьПоНаименованию
	|			И Визы.Виза.Наименование ПОДОБНО &ВизаШаблон СПЕЦСИМВОЛ ""\""))
	|	И (&ДатаНачПуста ИЛИ Визы.ДатаУстановки >= &ДатаНач)
	|	И (&ДатаКонПуста ИЛИ Визы.ДатаУстановки <= &ДатаКон)
	|	И (&БезФильтраСтатуса
	|		ИЛИ (&ТолькоАктивные  И Визы.АктивнаяВиза)
	|		ИЛИ (&ТолькоПодписан  И Визы.Решение.ТипРешения = ЗНАЧЕНИЕ(Перечисление.бит_ТипыРешений.Согласующее))
	|		ИЛИ (&ТолькоОтклонён  И Визы.Решение.ТипРешения = ЗНАЧЕНИЕ(Перечисление.бит_ТипыРешений.Отклоняющее)))
	|	И (&НеФильтроватьПоАктивности
	|		ИЛИ (ЕСТЬNULL(НА.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)))
	|	И (&НеФильтроватьПоАктивности
	|		ИЛИ НЕ Визы.ТочкаАлгоритма.Наименование ПОДОБНО &ШаблонНеИспользуется СПЕЦСИМВОЛ ""\"")
	|УПОРЯДОЧИТЬ ПО
	|	Визы.ДатаУстановки УБЫВ,
	|	КодСортировки";

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&&Лимит", Формат(ЗапасЗаписей, "ЧГ=0"));

	ДатаНач = ДатаИзСтроки(ДатаНачСтр);
	ДатаКон = КонецДняИзСтроки(ДатаКонСтр);

	Запрос.УстановитьПараметр("КодВизы",          СокрЛП(КодВизы));
	Запрос.УстановитьПараметр("ВизаШаблон",       ШаблонПодобно(КодВизы));
	Запрос.УстановитьПараметр("ИскатьПоНаименованию", ИскатьВизуПоНаименованию(КодВизы));
	Запрос.УстановитьПараметр("КодВизыПуст",      Не ЗначениеЗаполнено(КодВизы));
	Запрос.УстановитьПараметр("ДатаНач",          ДатаНач);
	Запрос.УстановитьПараметр("ДатаНачПуста",     Не ЗначениеЗаполнено(ДатаНач));
	Запрос.УстановитьПараметр("ДатаКон",          ДатаКон);
	Запрос.УстановитьПараметр("ДатаКонПуста",     Не ЗначениеЗаполнено(ДатаКон));
	Запрос.УстановитьПараметр("БезФильтраСтатуса", ФильтрСтатус = "all" Или Не ЗначениеЗаполнено(ФильтрСтатус));
	Запрос.УстановитьПараметр("ТолькоАктивные",   ФильтрСтатус = "active");
	Запрос.УстановитьПараметр("ТолькоПодписан",   ФильтрСтатус = "signed");
	Запрос.УстановитьПараметр("ТолькоОтклонён",   ФильтрСтатус = "rejected");
	Запрос.УстановитьПараметр("ПустойUID",        Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.УстановитьПараметр("НеФильтроватьПоАктивности", Не ТолькоАктивныеМаршруты);
	Запрос.УстановитьПараметр("ШаблонНеИспользуется", "%не используется%");

	Выборка = Запрос.Выполнить().Выгрузить();

	// Фильтр по типу документа (частичное совпадение с именем/синонимом типа)
	Результат    = Новый Массив;
	ТипДокФильтр = НРег(СокрЛП(ТипДок));

	Для Каждого СтрокаВыборки Из Выборка Цикл
		ИмяТипа = ИмяТипаОбъекта(СтрокаВыборки.Объект);
		Если ЗначениеЗаполнено(ТипДокФильтр) И СтрНайти(НРег(ИмяТипа), ТипДокФильтр) = 0 Тогда
			Продолжить;
		КонецЕсли;

		// ФИО не передаётся. user_uid = ИдентификаторПользователяИБ.
		// Пустой UID (все нули) означает, что виза ещё не подписана (пользователь не назначен).
		УИДСтрока = "";
		Если ЗначениеЗаполнено(СтрокаВыборки.ПользовательUID) Тогда
			УИДСтрока = Строка(СтрокаВыборки.ПользовательUID);
		КонецЕсли;

		Эл = Новый Соответствие;
		Эл.Вставить("document_type",   ИмяТипа);
		Эл.Вставить("document",        Строка(СтрокаВыборки.Объект));
		Эл.Вставить("visa_name",       СтрокаВыборки.ВизаНаименование);
		Эл.Вставить("visa_code",       СтрокаВыборки.ВизаКод);
		Эл.Вставить("visa_kind",       СтрокаВыборки.ВизаВид);
		Эл.Вставить("visa_letter",     СтрокаВыборки.ВизаЛитера);
		Эл.Вставить("position",        СтрокаВыборки.Должность);
		Эл.Вставить("user_uid",        УИДСтрока);
		Эл.Вставить("status",          СтрокаВыборки.СтатусНаименование);
		Эл.Вставить("status_kind",     СтрокаВыборки.СтатусТип);
		Эл.Вставить("decision",        СтрокаВыборки.РешениеНаименование);
		Эл.Вставить("decision_kind",   СтрокаВыборки.РешениеТип);
		Эл.Вставить("route",           СтрокаВыборки.Маршрут);
		Эл.Вставить("algorithm",       СтрокаВыборки.АлгоритмНаименование);
		Эл.Вставить("algorithm_code",  СтрокаВыборки.АлгоритмКод);
		Эл.Вставить("algorithm_step",  СтрокаВыборки.ТочкаАлгоритма);
		Эл.Вставить("step_code",       СтрокаВыборки.ТочкаКод);
		Эл.Вставить("step_id",         СтрокаВыборки.ТочкаИдентификатор);
		Эл.Вставить("sort_order",      СтрокаВыборки.КодСортировки);
		Эл.Вставить("is_active",       СтрокаВыборки.АктивнаяВиза);
		Эл.Вставить("is_signed",       СтрокаВыборки.ПодписанЭП);
		Эл.Вставить("is_manual",       СтрокаВыборки.ДобавленаВручную);
		Эл.Вставить("date_set",        ДатаВСтроку(СтрокаВыборки.ДатаУстановки));
		Эл.Вставить("deadline",        ДатаВСтроку(СтрокаВыборки.ДатаКрайняя));
		Эл.Вставить("time_to_set_min", СтрокаВыборки.ВремяНаУстановку);
		Эл.Вставить("ai_comment",      СтрокаВыборки.КомментарийИИ);
		Результат.Добавить(Эл);

		Если Результат.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("mode",  "visas");
	Итог.Вставить("count", Результат.Количество());
	Итог.Вставить("items", Результат);
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

// ─── Режим routes ────────────────────────────────────────────────────────────
//
// Уникальные маршруты с шагами алгоритма и составом виз.
//
Функция МаршрутыАлгоритмов(КодВизы, ТипДок, ДатаНачСтр, ДатаКонСтр, Лимит, КодАлгоритма = "", ТолькоАктивныеМаршруты = Истина)

	// Маршрут — строковый реквизит регистра, в большинстве баз он не заполняется,
	// поэтому первичной единицей группировки служит АЛГОРИТМ, а маршрут — уточнение.
	// Сырую выборку обязательно ограничиваем ПЕРВЫЕ: регистр установленных виз
	// содержит сотни тысяч записей, полный скан не укладывается в таймаут HTTP-сервиса.
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ &&Скан
	|	Визы.Объект                                    КАК Объект,
	|	ЕСТЬNULL(Визы.Маршрут, """")                   КАК Маршрут,
	|	ЕСТЬNULL(Визы.Алгоритм.Наименование, """")     КАК АлгоритмНаименование,
	|	ЕСТЬNULL(Визы.Алгоритм.Код, """")              КАК АлгоритмКод,
	|	ЕСТЬNULL(Визы.ТочкаАлгоритма.Наименование, """") КАК ТочкаАлгоритма,
	|	ЕСТЬNULL(Визы.ТочкаАлгоритма.КодТочки, """")   КАК ТочкаКод,
	|	ЕСТЬNULL(Визы.ТочкаАлгоритма.ИдентификаторТочки, 0) КАК ТочкаИдентификатор,
	|	ПРЕДСТАВЛЕНИЕ(Визы.ТочкаАлгоритма.ВидТочки)    КАК ТочкаВид,
	|	ЕСТЬNULL(Визы.КодСортировки, 0)                КАК КодСортировки,
	|	ЕСТЬNULL(Визы.Виза.Наименование, """")         КАК ВизаНаименование,
	|	ЕСТЬNULL(Визы.Виза.Кодификатор, """")          КАК ВизаКод,
	|	ПРЕДСТАВЛЕНИЕ(Визы.Виза.Вид)                   КАК ВизаВид,
	|	ЕСТЬNULL(Визы.Виза.Литера, """")               КАК ВизаЛитера,
	|	ЕСТЬNULL(Визы.Должность, """")                 КАК Должность
	|ПОМЕСТИТЬ ВизыСырые
	|ИЗ
	|	РегистрСведений.бит_УстановленныеВизы КАК Визы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НазначениеАлгоритмов КАК НА
	|		ПО НА.Алгоритм = Визы.Алгоритм
	|			И НА.ВидАлгоритма = ЗНАЧЕНИЕ(Перечисление.бит_ВидыАлгоритмов.Визирование)
	|ГДЕ
	|	НЕ Визы.Виза.ПометкаУдаления
	|	И (&КодВизыПуст
	|		ИЛИ Визы.Виза.Литера = &КодВизы
	|		ИЛИ Визы.Виза.Кодификатор = &КодВизы
	|		ИЛИ (&ИскатьПоНаименованию
	|			И Визы.Виза.Наименование ПОДОБНО &ВизаШаблон СПЕЦСИМВОЛ ""\""))
	|	И (&ДатаНачПуста ИЛИ Визы.ДатаУстановки >= &ДатаНач)
	|	И (&ДатаКонПуста ИЛИ Визы.ДатаУстановки <= &ДатаКон)
	|	И (&КодАлгоритмаПуст ИЛИ Визы.Алгоритм.Код = &КодАлгоритма)
	|	И (&НеФильтроватьПоАктивности
	|		ИЛИ (ЕСТЬNULL(НА.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)))
	|	И (&НеФильтроватьПоАктивности
	|		ИЛИ НЕ Визы.ТочкаАлгоритма.Наименование ПОДОБНО &ШаблонНеИспользуется СПЕЦСИМВОЛ ""\"")
	|УПОРЯДОЧИТЬ ПО
	|	Визы.ДатаУстановки УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	ВизыСырые.Маршрут                КАК Маршрут,
	|	ВизыСырые.АлгоритмНаименование   КАК АлгоритмНаименование,
	|	ВизыСырые.АлгоритмКод            КАК АлгоритмКод,
	|	ВизыСырые.ТочкаАлгоритма         КАК ТочкаАлгоритма,
	|	ВизыСырые.ТочкаКод               КАК ТочкаКод,
	|	ВизыСырые.ТочкаИдентификатор     КАК ТочкаИдентификатор,
	|	ВизыСырые.ТочкаВид               КАК ТочкаВид,
	|	ВизыСырые.КодСортировки          КАК КодСортировки,
	|	ВизыСырые.ВизаНаименование       КАК ВизаНаименование,
	|	ВизыСырые.ВизаКод                КАК ВизаКод,
	|	ВизыСырые.ВизаВид                КАК ВизаВид,
	|	ВизыСырые.ВизаЛитера             КАК ВизаЛитера,
	|	ВизыСырые.Должность              КАК Должность,
	|	МАКСИМУМ(ВизыСырые.Объект)       КАК Объект,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВизыСырые.Объект) КАК КоличествоДокументов
	|ИЗ
	|	ВизыСырые КАК ВизыСырые
	|СГРУППИРОВАТЬ ПО
	|	ВизыСырые.Маршрут,
	|	ВизыСырые.АлгоритмНаименование,
	|	ВизыСырые.АлгоритмКод,
	|	ВизыСырые.ТочкаАлгоритма,
	|	ВизыСырые.ТочкаКод,
	|	ВизыСырые.ТочкаИдентификатор,
	|	ВизыСырые.ТочкаВид,
	|	ВизыСырые.КодСортировки,
	|	ВизыСырые.ВизаНаименование,
	|	ВизыСырые.ВизаКод,
	|	ВизыСырые.ВизаВид,
	|	ВизыСырые.ВизаЛитера,
	|	ВизыСырые.Должность
	|УПОРЯДОЧИТЬ ПО
	|	АлгоритмКод,
	|	ТочкаИдентификатор,
	|	КодСортировки";

	// Сырой скан регистра ограничиваем жёстко — иначе HTTP-сервис уходит в таймаут.
	// Фильтр по типу документа применяется после выборки, поэтому берём с запасом.
	ЛимитСкана = ?(ЗначениеЗаполнено(ТипДок), 20000, 5000);

	ЗапасЗаписей = ?(ЗначениеЗаполнено(ТипДок), Лимит * 40, Лимит * 20);
	Если ЗапасЗаписей > 4000 Тогда
		ЗапасЗаписей = 4000;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&&Скан",  Формат(ЛимитСкана,   "ЧГ=0"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&&Лимит", Формат(ЗапасЗаписей, "ЧГ=0"));

	ДатаНач = ДатаИзСтроки(ДатаНачСтр);
	ДатаКон = КонецДняИзСтроки(ДатаКонСтр);

	Запрос.УстановитьПараметр("КодВизы",           СокрЛП(КодВизы));
	Запрос.УстановитьПараметр("ВизаШаблон",        ШаблонПодобно(КодВизы));
	Запрос.УстановитьПараметр("ИскатьПоНаименованию", ИскатьВизуПоНаименованию(КодВизы));
	Запрос.УстановитьПараметр("КодВизыПуст",       Не ЗначениеЗаполнено(КодВизы));
	Запрос.УстановитьПараметр("ДатаНач",           ДатаНач);
	Запрос.УстановитьПараметр("ДатаНачПуста",      Не ЗначениеЗаполнено(ДатаНач));
	Запрос.УстановитьПараметр("ДатаКон",           ДатаКон);
	Запрос.УстановитьПараметр("ДатаКонПуста",      Не ЗначениеЗаполнено(ДатаКон));
	Запрос.УстановитьПараметр("КодАлгоритма",      КодАлгоритма);
	Запрос.УстановитьПараметр("КодАлгоритмаПуст",  Не ЗначениеЗаполнено(КодАлгоритма));
	Запрос.УстановитьПараметр("НеФильтроватьПоАктивности", Не ТолькоАктивныеМаршруты);
	Запрос.УстановитьПараметр("ШаблонНеИспользуется", "%не используется%");

	Выборка = Запрос.Выполнить().Выгрузить();

	// Группируем: маршрут → шаги → визы
	МаршрутыМап   = Новый Соответствие;
	ПорядокКлючей = Новый Массив;
	ТипДокФильтр  = НРег(СокрЛП(ТипДок));

	Для Каждого Стр Из Выборка Цикл
		ИмяТипа = ИмяТипаОбъекта(Стр.Объект);
		Если ЗначениеЗаполнено(ТипДокФильтр) И СтрНайти(НРег(ИмяТипа), ТипДокФильтр) = 0 Тогда
			Продолжить;
		КонецЕсли;

		НазвМаршрута = Стр.Маршрут;
		Если Не ЗначениеЗаполнено(НазвМаршрута) Тогда
			// Реквизит Маршрут в базе как правило пуст — тогда маршрут
			// идентифицируется алгоритмом визирования
			НазвМаршрута = Стр.АлгоритмНаименование;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НазвМаршрута) Тогда
			НазвМаршрута = "<без маршрута>";
		КонецЕсли;

		// Ключ группировки — алгоритм + тип документа: именно эта пара
		// определяет уникальный маршрут согласования
		КлючМаршрута = Стр.АлгоритмКод + " | " + ИмяТипа;

		МапМаршрута = МаршрутыМап[КлючМаршрута];
		Если МапМаршрута = Неопределено Тогда
			Если ПорядокКлючей.Количество() >= Лимит Тогда
				Продолжить;
			КонецЕсли;
			МапМаршрута = Новый Соответствие;
			МапМаршрута.Вставить("route",          НазвМаршрута);
			МапМаршрута.Вставить("document_type",  ИмяТипа);
			МапМаршрута.Вставить("algorithm",      Стр.АлгоритмНаименование);
			МапМаршрута.Вставить("algorithm_code", Стр.АлгоритмКод);
			МапМаршрута.Вставить("steps",          Новый Массив);
			МаршрутыМап.Вставить(КлючМаршрута, МапМаршрута);
			ПорядокКлючей.Добавить(КлючМаршрута);
		КонецЕсли;

		// Ищем шаг внутри маршрута
		ШагиМассив = МапМаршрута["steps"];
		МапШага    = Неопределено;
		Для Каждого Шаг Из ШагиМассив Цикл
			Если Шаг["step"] = Стр.ТочкаАлгоритма И Шаг["sort_order"] = Стр.КодСортировки Тогда
				МапШага = Шаг;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если МапШага = Неопределено Тогда
			МапШага = Новый Соответствие;
			МапШага.Вставить("step",       Стр.ТочкаАлгоритма);
			МапШага.Вставить("step_code",  Стр.ТочкаКод);
			МапШага.Вставить("step_id",    Стр.ТочкаИдентификатор);
			МапШага.Вставить("step_kind",  Стр.ТочкаВид);
			МапШага.Вставить("sort_order", Стр.КодСортировки);
			МапШага.Вставить("visas",      Новый Массив);
			ШагиМассив.Добавить(МапШага);
		КонецЕсли;

		// Добавляем визу в шаг (без дублей)
		ВизаЕсть = Ложь;
		Для Каждого ВизаЭл Из МапШага["visas"] Цикл
			Если ВизаЭл["name"] = Стр.ВизаНаименование И ВизаЭл["position"] = Стр.Должность Тогда
				ВизаЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Не ВизаЕсть Тогда
			МапВизы = Новый Соответствие;
			МапВизы.Вставить("name",      Стр.ВизаНаименование);
			МапВизы.Вставить("code",      Стр.ВизаКод);
			МапВизы.Вставить("kind",      Стр.ВизаВид);
			МапВизы.Вставить("letter",    Стр.ВизаЛитера);
			МапВизы.Вставить("position",  Стр.Должность);
			МапВизы.Вставить("doc_count", Стр.КоличествоДокументов);
			МапШага["visas"].Добавить(МапВизы);
		КонецЕсли;
	КонецЦикла;

	// Собираем в массив с сохранением порядка сортировки запроса
	МаршрутыМассив = Новый Массив;
	Для Каждого Ключ Из ПорядокКлючей Цикл
		МаршрутыМассив.Добавить(МаршрутыМап[Ключ]);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("mode",   "routes");
	Итог.Вставить("count",  МаршрутыМассив.Количество());
	Итог.Вставить("routes", МаршрутыМассив);
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

// ─── Режим rights ────────────────────────────────────────────────────────────
//
// Права установки виз. ФИО скрыты — возвращаются только группы пользователей.
//
// Параметры:
//  КодВизы          - Строка - фильтр по литере/кодификатору/наименованию визы
//  Лимит            - Число  - максимум строк
//  UIDПользователя  - Строка - ИдентификаторПользователяИБ; пусто — вся матрица прав
//  УчитыватьГруппы  - Булево - при отборе по сотруднику учитывать права его групп
//
Функция ПраваУстановкиВиз(КодВизы, Лимит, Знач UIDПользователя = "", Знач УчитыватьГруппы = Истина)

	// Отбор по сотруднику: сначала находим его ссылку и группы, затем сужаем выборку.
	// Измерение Пользователь — составного типа (Пользователи | ГруппыПользователей),
	// и подавляющее большинство прав выдаётся именно группам, поэтому без учёта
	// групп отбор по конкретному человеку почти всегда возвращал бы пустой результат.
	// Пустая ссылка, а не Неопределено: измерение Пользователь составного типа,
	// и сравнение с Неопределено в запросе ведёт себя менее предсказуемо.
	ОтборПоПользователю = ЗначениеЗаполнено(UIDПользователя);
	СсылкаПользователя  = Справочники.Пользователи.ПустаяСсылка();
	ГруппыПользователя  = Новый Массив;

	Если ОтборПоПользователю Тогда
		РезультатПоиска = НайтиПользователяПоUID(UIDПользователя);
		Если РезультатПоиска.Ошибка <> "" Тогда
			Возврат ОтветОбОшибкеПоискаПользователя(РезультатПоиска, UIDПользователя, "rights");
		КонецЕсли;
		СсылкаПользователя = РезультатПоиска.Ссылка;

		Если УчитыватьГруппы Тогда
			ГруппыПользователя = ГруппыПользователяПоСсылке(СсылкаПользователя);
		КонецЕсли;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	ЕСТЬNULL(ПраваВиз.Виза.Наименование, """")    КАК ВизаНаименование,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ПраваВиз.Виза КАК Справочник.бит_Визы).Кодификатор, """") КАК ВизаКод,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ПраваВиз.Виза КАК Справочник.бит_Визы).Литера, """") КАК ВизаЛитера,
	|	ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(ПраваВиз.Виза КАК Справочник.бит_Визы).Вид) КАК ВизаВид,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПраваВиз.Пользователь) = ТИП(Справочник.ГруппыПользователей)
	|			ТОГДА ""Группа""
	|		ИНАЧЕ ""Пользователь""
	|	КОНЕЦ                                         КАК ТипПользователя,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПраваВиз.Пользователь) = ТИП(Справочник.ГруппыПользователей)
	|			ТОГДА ПраваВиз.Пользователь.Наименование
	|		ИНАЧЕ ""[Конкретный пользователь]""
	|	КОНЕЦ                                         КАК СубъектПользователь,
	|	ЕСТЬNULL(ПраваВиз.ПользовательскоеУсловие.Наименование, """") КАК УсловиеНаименование,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ПраваВиз.Замещаемый) = ТИП(Справочник.ГруппыПользователей)
	|			ТОГДА ПраваВиз.Замещаемый.Наименование
	|		КОГДА ПраваВиз.Замещаемый = НЕОПРЕДЕЛЕНО
	|			ТОГДА """"
	|		ИНАЧЕ ""[Конкретный пользователь]""
	|	КОНЕЦ                                         КАК СубъектЗамещаемый,
	|	ВЫБОР
	|		КОГДА ПраваВиз.Пользователь = &Пользователь
	|			ТОГДА ""direct""
	|		ИНАЧЕ ""group""
	|	КОНЕЦ                                         КАК СпособПолучения
	|ИЗ
	|	РегистрСведений.бит_ПраваУстановкиВиз КАК ПраваВиз
	|ГДЕ
	|	НЕ ЕСТЬNULL(ПраваВиз.Виза.ПометкаУдаления, ЛОЖЬ)
	|	И (&КодВизыПуст
	|		ИЛИ ВЫРАЗИТЬ(ПраваВиз.Виза КАК Справочник.бит_Визы).Литера = &КодВизы
	|		ИЛИ ВЫРАЗИТЬ(ПраваВиз.Виза КАК Справочник.бит_Визы).Кодификатор = &КодВизы
	|		ИЛИ (&ИскатьПоНаименованию
	|			И ПраваВиз.Виза.Наименование ПОДОБНО &ВизаШаблон СПЕЦСИМВОЛ ""\""))
	|	И (&БезОтбораПоПользователю
	|		ИЛИ ПраваВиз.Пользователь = &Пользователь
	|		ИЛИ ПраваВиз.Пользователь В (&ГруппыПользователя))
	|УПОРЯДОЧИТЬ ПО
	|	ВизаНаименование";

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&&Лимит", Формат(Лимит, "ЧГ=0"));

	Запрос.УстановитьПараметр("КодВизы",     СокрЛП(КодВизы));
	Запрос.УстановитьПараметр("ВизаШаблон",  ШаблонПодобно(КодВизы));
	Запрос.УстановитьПараметр("ИскатьПоНаименованию", ИскатьВизуПоНаименованию(КодВизы));
	Запрос.УстановитьПараметр("КодВизыПуст", Не ЗначениеЗаполнено(КодВизы));
	Запрос.УстановитьПараметр("БезОтбораПоПользователю", Не ОтборПоПользователю);
	Запрос.УстановитьПараметр("Пользователь",       СсылкаПользователя);
	Запрос.УстановитьПараметр("ГруппыПользователя", ГруппыПользователя);

	Выборка = Запрос.Выполнить().Выгрузить();

	Результат = Новый Массив;
	Для Каждого Стр Из Выборка Цикл
		Эл = Новый Соответствие;
		Эл.Вставить("visa_name",   Стр.ВизаНаименование);
		Эл.Вставить("visa_code",   Стр.ВизаКод);
		Эл.Вставить("visa_letter", Стр.ВизаЛитера);
		Эл.Вставить("visa_kind",   Стр.ВизаВид);
		Эл.Вставить("user_type",  Стр.ТипПользователя);
		Эл.Вставить("subject",    Стр.СубъектПользователь);
		Эл.Вставить("condition",  Стр.УсловиеНаименование);
		Эл.Вставить("substitute", Стр.СубъектЗамещаемый);
		// Как именно получено право: лично или через группу пользователей.
		// Осмысленно только при отборе по сотруднику.
		Если ОтборПоПользователю Тогда
			Эл.Вставить("granted_via", Стр.СпособПолучения);
		КонецЕсли;
		Результат.Добавить(Эл);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("mode",  "rights");
	Итог.Вставить("count", Результат.Количество());
	Итог.Вставить("items", Результат);

	Если ОтборПоПользователю Тогда
		Итог.Вставить("user_uid",        UUIDВСтроку(UIDПользователя));
		Итог.Вставить("include_groups",  УчитыватьГруппы);
		Итог.Вставить("groups_searched", ГруппыПользователя.Количество());
		Если Результат.Количество() = 0 Тогда
			Итог.Вставить("hint", ?(УчитыватьГруппы,
				"Прав установки виз не найдено — ни персональных, ни через группы пользователей."
					+ " Сотрудник не участвует в согласовании как подписант.",
				"Персональных прав не найдено. Права на визы обычно выдаются группам:"
					+ " повторите вызов с include_groups=true."));
		КонецЕсли;
		Итог.Вставить("privacy_note",
			"ФИО не передаётся — поиск по ИдентификаторПользователяИБ выполнен внутри 1С.");
	КонецЕсли;

	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

// Возвращает массив ссылок на группы пользователей, в состав которых входит сотрудник.
// Учитываются обе табличные части справочника ГруппыПользователей: типовая «Состав»
// и «бит_стр_ПользователиГруппы20», которую использует БИТ.ФИНАНС.
//
// Параметры:
//  СсылкаПользователя - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.ГруппыПользователей
//
Функция ГруппыПользователяПоСсылке(Знач СсылкаПользователя)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Состав.Ссылка КАК Группа
	|ИЗ
	|	Справочник.ГруппыПользователей.Состав КАК Состав
	|ГДЕ
	|	Состав.Пользователь = &Пользователь
	|	И НЕ Состав.Ссылка.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоставБИТ.Ссылка
	|ИЗ
	|	Справочник.ГруппыПользователей.бит_стр_ПользователиГруппы20 КАК СоставБИТ
	|ГДЕ
	|	СоставБИТ.Пользователь = &Пользователь
	|	И НЕ СоставБИТ.Ссылка.ПометкаУдаления");

	Запрос.УстановитьПараметр("Пользователь", СсылкаПользователя);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Группа");

КонецФункции

// ─── Режим algorithm ─────────────────────────────────────────────────────────
//
// Шаги алгоритма. бит_ТочкиАлгоритмов — подчинённый справочник
// (владелец — бит_АлгоритмыПроцессов), а не табличная часть.
//
Функция ШагиАлгоритма(КодАлгоритма, Лимит)

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	Алгоритм.Наименование                          КАК АлгоритмНаименование,
	|	Алгоритм.Код                                   КАК АлгоритмКод,
	|	ЕСТЬNULL(Точки.Наименование, """")             КАК ТочкаНаименование,
	|	ЕСТЬNULL(Точки.Код, """")                      КАК ТочкаКод,
	|	ЕСТЬNULL(Точки.КодТочки, """")                 КАК КодТочки,
	|	ЕСТЬNULL(Точки.ИдентификаторТочки, 0)          КАК ИдентификаторТочки,
	|	ПРЕДСТАВЛЕНИЕ(Точки.ВидТочки)                  КАК ВидТочки,
	|	ЕСТЬNULL(Точки.АктивнаяТочкаМаршрута, ЛОЖЬ)    КАК АктивнаяТочка,
	|	ЕСТЬNULL(Точки.ПользовательскоеУсловие.Наименование, """") КАК Условие
	|ИЗ
	|	Справочник.бит_АлгоритмыПроцессов КАК Алгоритм
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ТочкиАлгоритмов КАК Точки
	|		ПО Точки.Владелец = Алгоритм.Ссылка
	|			И НЕ Точки.ПометкаУдаления
	|ГДЕ
	|	НЕ Алгоритм.ПометкаУдаления
	|	И НЕ Алгоритм.ЭтоГруппа
	|	И (&КодАлгоритмаПуст ИЛИ Алгоритм.Код = &КодАлгоритма)
	|УПОРЯДОЧИТЬ ПО
	|	АлгоритмНаименование,
	|	ИдентификаторТочки";

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "&&Лимит", Формат(Лимит, "ЧГ=0"));

	Запрос.УстановитьПараметр("КодАлгоритма",     КодАлгоритма);
	Запрос.УстановитьПараметр("КодАлгоритмаПуст", Не ЗначениеЗаполнено(КодАлгоритма));

	Выборка = Запрос.Выполнить().Выгрузить();

	// Группируем: алгоритм → шаги
	АлгоритмыМап  = Новый Соответствие;
	ПорядокКлючей = Новый Массив;

	Для Каждого Стр Из Выборка Цикл
		КлючАлг = Стр.АлгоритмКод;
		МапАлг  = АлгоритмыМап[КлючАлг];
		Если МапАлг = Неопределено Тогда
			МапАлг = Новый Соответствие;
			МапАлг.Вставить("algorithm_code", Стр.АлгоритмКод);
			МапАлг.Вставить("algorithm_name", Стр.АлгоритмНаименование);
			МапАлг.Вставить("steps",          Новый Массив);
			АлгоритмыМап.Вставить(КлючАлг, МапАлг);
			ПорядокКлючей.Добавить(КлючАлг);
		КонецЕсли;

		Если ЗначениеЗаполнено(Стр.ТочкаНаименование) Тогда
			МапШага = Новый Соответствие;
			МапШага.Вставить("step_id",     Стр.ИдентификаторТочки);
			МапШага.Вставить("step_code",   Стр.КодТочки);
			МапШага.Вставить("step_name",   Стр.ТочкаНаименование);
			МапШага.Вставить("step_kind",   Стр.ВидТочки);
			МапШага.Вставить("is_active",   Стр.АктивнаяТочка);
			МапШага.Вставить("condition",   Стр.Условие);
			МапАлг["steps"].Добавить(МапШага);
		КонецЕсли;
	КонецЦикла;

	АлгоритмыМассив = Новый Массив;
	Для Каждого Ключ Из ПорядокКлючей Цикл
		АлгоритмыМассив.Добавить(АлгоритмыМап[Ключ]);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("mode",       "algorithm");
	Итог.Вставить("count",      АлгоритмыМассив.Количество());
	Итог.Вставить("algorithms", АлгоритмыМассив);
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

// ─── Режим route_graph ───────────────────────────────────────────────────────
//
// Граф маршрута согласования: узлы (точки алгоритма) и переходы между ними.
// Переходы берутся из ТЧ бит_ТочкиАлгоритмов.ИсходящиеТочки.
// К каждому узлу подтягивается состав виз из фактически установленных виз.
// Результат пригоден для построения блок-схемы (Mermaid flowchart).
//
Функция ГрафМаршрута(КодАлгоритма, ТипДок, Лимит)

	// 1. Узлы алгоритма
	ТекстУзлов =
	"ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	Алгоритм.Код                                КАК АлгоритмКод,
	|	Алгоритм.Наименование                       КАК АлгоритмНаименование,
	|	ПРЕДСТАВЛЕНИЕ(Алгоритм.ВидАлгоритма)        КАК ВидАлгоритма,
	|	ПРЕДСТАВЛЕНИЕ(Алгоритм.СпособВыполнения)    КАК СпособВыполнения,
	|	Точки.Ссылка                                КАК ТочкаСсылка,
	|	Точки.Наименование                          КАК ТочкаНаименование,
	|	ЕСТЬNULL(Точки.КодТочки, """")              КАК КодТочки,
	|	ЕСТЬNULL(Точки.ИдентификаторТочки, 0)       КАК ИдентификаторТочки,
	|	ПРЕДСТАВЛЕНИЕ(Точки.ВидТочки)               КАК ВидТочки,
	|	ЕСТЬNULL(Точки.АктивнаяТочкаМаршрута, ЛОЖЬ) КАК АктивнаяТочка,
	|	ЕСТЬNULL(Точки.ПользовательскоеУсловие.Наименование, """") КАК Условие,
	|	Точки.ПользовательскоеУсловие               КАК УсловиеСсылка,
	|	ЕСТЬNULL(Точки.ПользовательскоеУсловие.КодУсловия, """") КАК УсловиеКод,
	|	ЕСТЬNULL(Точки.ПользовательскоеУсловие.ПроизвольноеУсловие, """") КАК УсловиеПроизвольное,
	|	ЕСТЬNULL(Точки.ПользовательскоеДействие.Наименование, """") КАК Действие,
	|	ЕСТЬNULL(Точки.ПользовательскоеДействие.Виза.Наименование, """") КАК ДействиеВизаНаименование,
	|	ЕСТЬNULL(Точки.ПользовательскоеДействие.Виза.Литера, """")       КАК ДействиеВизаЛитера,
	|	ПРЕДСТАВЛЕНИЕ(Точки.ПользовательскоеДействие.Виза.Вид)           КАК ДействиеВизаВид,
	|	ЕСТЬNULL(Точки.ПользовательскоеДействие.РольИсполнителя.Наименование, """") КАК ДействиеРоль,
	|	ЕСТЬNULL(Точки.ПользовательскоеДействие.Исполнитель.Наименование, """")     КАК ДействиеИсполнитель
	|ИЗ
	|	Справочник.бит_АлгоритмыПроцессов КАК Алгоритм
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ТочкиАлгоритмов КАК Точки
	|		ПО Точки.Владелец = Алгоритм.Ссылка
	|			И НЕ Точки.ПометкаУдаления
	|ГДЕ
	|	НЕ Алгоритм.ПометкаУдаления
	|	И НЕ Алгоритм.ЭтоГруппа
	|	И (&КодАлгоритмаПуст ИЛИ Алгоритм.Код = &КодАлгоритма)
	|	И (&ТипДокПуст ИЛИ Алгоритм.Наименование ПОДОБНО &ТипДокШаблон СПЕЦСИМВОЛ ""\"")
	|УПОРЯДОЧИТЬ ПО
	|	АлгоритмКод,
	|	ИдентификаторТочки";

	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(ТекстУзлов, "&&Лимит", Формат(Лимит * 40, "ЧГ=0"));
	Запрос.УстановитьПараметр("КодАлгоритма",     КодАлгоритма);
	Запрос.УстановитьПараметр("КодАлгоритмаПуст", Не ЗначениеЗаполнено(КодАлгоритма));
	Запрос.УстановитьПараметр("ТипДокПуст",       Не ЗначениеЗаполнено(ТипДок));
	Запрос.УстановитьПараметр("ТипДокШаблон",     ШаблонПодобно(ТипДок));

	ТаблицаУзлов = Запрос.Выполнить().Выгрузить();

	Если ТаблицаУзлов.Количество() = 0 Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("mode",   "route_graph");
		Итог.Вставить("count",  0);
		Итог.Вставить("graphs", Новый Массив);
		Итог.Вставить("hint",   "Алгоритмы не найдены. Уточните algorithm_code или document_type"
			+ " (ищется вхождение в наименование алгоритма, например 'Заявка на затраты').");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	// 2. Переходы между узлами.
	// ВАЖНО: связь может быть записана только с одной стороны — в ИсходящиеТочки
	// источника ЛИБО во ВходящиеТочки приёмника. Если читать только исходящие,
	// у условий теряется ветка «Нет» и маршрут на схеме обрывается.
	// Поэтому объединяем обе ТЧ и снимаем дубли.
	МассивТочек = ТаблицаУзлов.ВыгрузитьКолонку("ТочкаСсылка");

	// Дубли (связь записана с двух сторон) снимаются в коде по паре «от → к»:
	// агрегатные функции и РАЗЛИЧНЫЕ к ЗначениеУсловия неприменимы —
	// тип составной (тысячи типов), запрос не компилируется.
	ТекстПереходов =
	"ВЫБРАТЬ
	|	Исходящие.Ссылка          КАК ТочкаОт,
	|	Исходящие.Точка           КАК ТочкаК,
	|	Исходящие.НомерСтроки     КАК НомерСтроки,
	|	Исходящие.ЗначениеУсловия КАК ЗначениеУсловия
	|ИЗ
	|	Справочник.бит_ТочкиАлгоритмов.ИсходящиеТочки КАК Исходящие
	|ГДЕ
	|	Исходящие.Ссылка В (&МассивТочек)
	|	И Исходящие.Точка <> ЗНАЧЕНИЕ(Справочник.бит_ТочкиАлгоритмов.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Входящие.Точка            КАК ТочкаОт,
	|	Входящие.Ссылка           КАК ТочкаК,
	|	Входящие.НомерСтроки      КАК НомерСтроки,
	|	Входящие.ЗначениеУсловия  КАК ЗначениеУсловия
	|ИЗ
	|	Справочник.бит_ТочкиАлгоритмов.ВходящиеТочки КАК Входящие
	|ГДЕ
	|	Входящие.Ссылка В (&МассивТочек)
	|	И Входящие.Точка <> ЗНАЧЕНИЕ(Справочник.бит_ТочкиАлгоритмов.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";

	ЗапросПереходов = Новый Запрос(ТекстПереходов);
	ЗапросПереходов.УстановитьПараметр("МассивТочек", МассивТочек);
	ТаблицаПереходов = ЗапросПереходов.Выполнить().Выгрузить();

	// 2а. Машиночитаемые правила условий (ТЧ бит_ПользовательскиеУсловия.Условия).
	// Наименование условия («Сумма от 30 до 150 млн.руб») — это лишь подпись,
	// а фактические пороги лежат здесь: Свойство + ВидСравнения + Значение.
	МассивУсловий = Новый Массив;
	Для Каждого СтрокаУзла Из ТаблицаУзлов Цикл
		Если ЗначениеЗаполнено(СтрокаУзла.УсловиеСсылка)
			И МассивУсловий.Найти(СтрокаУзла.УсловиеСсылка) = Неопределено Тогда
			МассивУсловий.Добавить(СтрокаУзла.УсловиеСсылка);
		КонецЕсли;
	КонецЦикла;

	ТаблицаПравил = Неопределено;
	Если МассивУсловий.Количество() > 0 Тогда
		ТекстПравил =
		"ВЫБРАТЬ
		|	Условия.Ссылка                      КАК УсловиеСсылка,
		|	Условия.НомерСтроки                 КАК НомерСтроки,
		|	ЕСТЬNULL(Условия.СкобкаНачало, """") КАК СкобкаНачало,
		|	ЕСТЬNULL(Условия.Свойство, """")    КАК Свойство,
		|	ПРЕДСТАВЛЕНИЕ(Условия.ВидСравнения) КАК ВидСравнения,
		|	Условия.Значение                    КАК ЗначениеУсловияПравила,
		|	ЕСТЬNULL(Условия.СкобкаКонец, """") КАК СкобкаКонец,
		|	ПРЕДСТАВЛЕНИЕ(Условия.ОбъединениеСПоследующим) КАК Объединение,
		|	ЕСТЬNULL(Условия.ЭтоВыражение, ЛОЖЬ) КАК ЭтоВыражение
		|ИЗ
		|	Справочник.бит_ПользовательскиеУсловия.Условия КАК Условия
		|ГДЕ
		|	Условия.Ссылка В (&МассивУсловий)
		|УПОРЯДОЧИТЬ ПО
		|	УсловиеСсылка,
		|	НомерСтроки";

		ЗапросПравил = Новый Запрос(ТекстПравил);
		ЗапросПравил.УстановитьПараметр("МассивУсловий", МассивУсловий);
		ТаблицаПравил = ЗапросПравил.Выполнить().Выгрузить();
	КонецЕсли;

	// 3. Фактически установленные визы по точкам — что реально подписывается на шаге
	ТекстВиз =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Визы.ТочкаАлгоритма                    КАК ТочкаАлгоритма,
	|	ЕСТЬNULL(Визы.Виза.Наименование, """") КАК ВизаНаименование,
	|	ЕСТЬNULL(Визы.Виза.Кодификатор, """")  КАК ВизаКод,
	|	ПРЕДСТАВЛЕНИЕ(Визы.Виза.Вид)           КАК ВизаВид,
	|	ЕСТЬNULL(Визы.Должность, """")         КАК Должность
	|ИЗ
	|	РегистрСведений.бит_УстановленныеВизы КАК Визы
	|ГДЕ
	|	Визы.ТочкаАлгоритма В (&МассивТочек)
	|	И НЕ Визы.Виза.ПометкаУдаления";

	ЗапросВиз = Новый Запрос(ТекстВиз);
	ЗапросВиз.УстановитьПараметр("МассивТочек", МассивТочек);
	ТаблицаВиз = ЗапросВиз.Выполнить().Выгрузить();

	// 4. Сборка графов по алгоритмам
	ГрафыМап       = Новый Соответствие;
	ПорядокКлючей  = Новый Массив;
	УзлыПоСсылке   = Новый Соответствие;
	УзлыПоУсловию  = Новый Соответствие;

	Для Каждого Стр Из ТаблицаУзлов Цикл
		МапГрафа = ГрафыМап[Стр.АлгоритмКод];
		Если МапГрафа = Неопределено Тогда
			Если ПорядокКлючей.Количество() >= Лимит Тогда
				Продолжить;
			КонецЕсли;
			МапГрафа = Новый Соответствие;
			МапГрафа.Вставить("algorithm_code",  Стр.АлгоритмКод);
			МапГрафа.Вставить("algorithm_name",  Стр.АлгоритмНаименование);
			МапГрафа.Вставить("algorithm_kind",  Стр.ВидАлгоритма);
			МапГрафа.Вставить("execution_mode",  Стр.СпособВыполнения);
			МапГрафа.Вставить("nodes",           Новый Массив);
			МапГрафа.Вставить("edges",           Новый Массив);
			ГрафыМап.Вставить(Стр.АлгоритмКод, МапГрафа);
			ПорядокКлючей.Добавить(Стр.АлгоритмКод);
		КонецЕсли;

		МапУзла = Новый Соответствие;
		МапУзла.Вставить("id",        Стр.ИдентификаторТочки);
		МапУзла.Вставить("code",      Стр.КодТочки);
		МапУзла.Вставить("name",      Стр.ТочкаНаименование);
		МапУзла.Вставить("kind",      Стр.ВидТочки);
		МапУзла.Вставить("is_active", Стр.АктивнаяТочка);
		МапУзла.Вставить("condition", Стр.Условие);
		МапУзла.Вставить("action",    Стр.Действие);

		// Визы: сначала из НАСТРОЕК маршрута (что назначено), затем из истории.
		// Раньше бралась только история — шаги без документов выглядели пустыми.
		МапУзла.Вставить("visas",          Новый Массив);  // назначено настройками
		МапУзла.Вставить("visas_actual",   Новый Массив);  // фактически визировали
		Если ЗначениеЗаполнено(Стр.ДействиеВизаНаименование) Тогда
			МапВизыНастр = Новый Соответствие;
			МапВизыНастр.Вставить("name",     Стр.ДействиеВизаНаименование);
			МапВизыНастр.Вставить("letter",   Стр.ДействиеВизаЛитера);
			МапВизыНастр.Вставить("kind",     Стр.ДействиеВизаВид);
			МапВизыНастр.Вставить("role",     Стр.ДействиеРоль);
			МапВизыНастр.Вставить("position", Стр.ДействиеВизаНаименование);
			МапВизыНастр.Вставить("source",   "настройка маршрута");
			МапУзла["visas"].Добавить(МапВизыНастр);
		КонецЕсли;
		МапУзла.Вставить("role",     Стр.ДействиеРоль);
		МапУзла.Вставить("assignee", Стр.ДействиеИсполнитель);

		// Машиночитаемое правило условия (пороги сумм и пр.)
		МапУзла.Вставить("condition_code",       Стр.УсловиеКод);
		МапУзла.Вставить("condition_expression", Стр.УсловиеПроизвольное);
		МапУзла.Вставить("condition_rules",      Новый Массив);
		МапУзла.Вставить("condition_text",       "");

		МапГрафа["nodes"].Добавить(МапУзла);

		// Индекс «ссылка точки → (граф, узел)» для переходов и виз
		Пара = Новый Соответствие;
		Пара.Вставить("graph", МапГрафа);
		Пара.Вставить("node",  МапУзла);
		УзлыПоСсылке.Вставить(Стр.ТочкаСсылка, Пара);

		// Индекс «ссылка условия → узлы» (одно условие может быть на нескольких точках)
		Если ЗначениеЗаполнено(Стр.УсловиеСсылка) Тогда
			СписокУзлов = УзлыПоУсловию[Стр.УсловиеСсылка];
			Если СписокУзлов = Неопределено Тогда
				СписокУзлов = Новый Массив;
				УзлыПоУсловию.Вставить(Стр.УсловиеСсылка, СписокУзлов);
			КонецЕсли;
			СписокУзлов.Добавить(МапУзла);
		КонецЕсли;
	КонецЦикла;

	// Правила условий → узлы (пороги по суммам и другим свойствам)
	Если ТаблицаПравил <> Неопределено Тогда
		Для Каждого Стр Из ТаблицаПравил Цикл
			СписокУзлов = УзлыПоУсловию[Стр.УсловиеСсылка];
			Если СписокУзлов = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			МапПравила = Новый Соответствие;
			МапПравила.Вставить("property",   Стр.Свойство);
			МапПравила.Вставить("comparison", Стр.ВидСравнения);
			МапПравила.Вставить("value",      ЗначениеПравилаВСтроку(Стр.ЗначениеУсловияПравила));
			МапПравила.Вставить("join",       Стр.Объединение);
			МапПравила.Вставить("bracket_open",  Стр.СкобкаНачало);
			МапПравила.Вставить("bracket_close", Стр.СкобкаКонец);

			Для Каждого МапЦелевогоУзла Из СписокУзлов Цикл
				МапЦелевогоУзла["condition_rules"].Добавить(МапПравила);
			КонецЦикла;
		КонецЦикла;

		// Человекочитаемая расшифровка правила: «СуммаДокумента >= 30 000 000 И < 150 000 000»
		Для Каждого ЭлУсл Из УзлыПоУсловию Цикл
			Для Каждого МапЦелевогоУзла Из ЭлУсл.Значение Цикл
				МапЦелевогоУзла.Вставить("condition_text",
					ТекстПравилУсловия(МапЦелевогоУзла["condition_rules"], МапЦелевогоУзла["condition_expression"]));
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	// Фактически установленные визы (история документов)
	Для Каждого Стр Из ТаблицаВиз Цикл
		Пара = УзлыПоСсылке[Стр.ТочкаАлгоритма];
		Если Пара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МапВизы = Новый Соответствие;
		МапВизы.Вставить("name",     Стр.ВизаНаименование);
		МапВизы.Вставить("code",     Стр.ВизаКод);
		МапВизы.Вставить("kind",     Стр.ВизаВид);
		МапВизы.Вставить("position", Стр.Должность);
		МапВизы.Вставить("source",   "фактически визировали");
		Пара["node"]["visas_actual"].Добавить(МапВизы);

		// Если настройками виза не задана — показываем фактическую,
		// иначе шаг остался бы пустым на схеме
		Если Пара["node"]["visas"].Количество() = 0 Тогда
			Пара["node"]["visas"].Добавить(МапВизы);
		КонецЕсли;
	КонецЦикла;

	// Переходы (только внутри выбранных алгоритмов).
	// Одна и та же связь может быть записана и в ИсходящиеТочки источника,
	// и во ВходящиеТочки приёмника — снимаем дубли по паре «от → к».
	УжеДобавлены = Новый Соответствие;

	Для Каждого Стр Из ТаблицаПереходов Цикл
		ПараОт = УзлыПоСсылке[Стр.ТочкаОт];
		ПараК  = УзлыПоСсылке[Стр.ТочкаК];
		Если ПараОт = Неопределено Или ПараК = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		КлючРебра = Строка(ПараОт["node"]["id"]) + ">" + Строка(ПараК["node"]["id"]);
		Если УжеДобавлены[КлючРебра] <> Неопределено Тогда
			// Уже есть — но если у текущей строки есть подпись ветки,
			// а у сохранённой её нет, обновляем подпись
			МапСохр = УжеДобавлены[КлючРебра];
			Если Не ЗначениеЗаполнено(МапСохр["label"]) Тогда
				МапСохр.Вставить("label", ПредставлениеУсловия(Стр.ЗначениеУсловия));
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		МапРебра = Новый Соответствие;
		МапРебра.Вставить("from",      ПараОт["node"]["id"]);
		МапРебра.Вставить("to",        ПараК["node"]["id"]);
		МапРебра.Вставить("from_name", ПараОт["node"]["name"]);
		МапРебра.Вставить("to_name",   ПараК["node"]["name"]);
		МапРебра.Вставить("label",     ПредставлениеУсловия(Стр.ЗначениеУсловия));
		ПараОт["graph"]["edges"].Добавить(МапРебра);
		УжеДобавлены.Вставить(КлючРебра, МапРебра);
	КонецЦикла;

	ГрафыМассив = Новый Массив;
	Для Каждого Ключ Из ПорядокКлючей Цикл
		ГрафыМассив.Добавить(ГрафыМап[Ключ]);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("mode",   "route_graph");
	Итог.Вставить("count",  ГрафыМассив.Количество());
	Итог.Вставить("graphs", ГрафыМассив);
	Итог.Вставить("hint",   "nodes.id — идентификатор узла, edges — переходы."
		+ " kind: Старт/Завершение/Действие/Условие/Разделение/Слияние."
		+ " Для узлов-условий: condition — подпись из справочника (может расходиться с правилом),"
		+ " condition_rules — МАШИНОЧИТАЕМОЕ правило (property/comparison/value), condition_text — его расшифровка."
		+ " Ограничения по суммам берите из condition_rules/condition_text, а НЕ из наименования."
		+ " visas — визы по настройке маршрута, visas_actual — кто фактически визировал."
		+ " Рёбра собраны из обеих ТЧ (ИсходящиеТочки + ВходящиеТочки).");
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

#КонецОбласти


#Область Инструмент_execute_query

Процедура ЗарегистрироватьИнструментExecuteQuery(ТаблицаИнструментов)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query",
		"string",
		"Текст запроса на языке запросов 1С. ТОЛЬКО ЧТЕНИЕ — разрешён лишь ВЫБРАТЬ."
			+ " Временные таблицы (ПОМЕСТИТЬ) и пакетные запросы поддерживаются."
			+ " Имена таблиц и полей уточняйте через list_metadata_objects / get_metadata_structure."
			+ " Пример: ВЫБРАТЬ ПЕРВЫЕ 10 Наименование, ИНН ИЗ Справочник.Контрагенты ГДЕ НЕ ПометкаУдаления",
		,
		Истина
	));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit",
		"number",
		"Максимум строк результата (по умолчанию 100, максимум 1000)",
		100
	));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	mcp_Метаданные.ДобавитьИнструмент(
		ТаблицаИнструментов,
		"execute_query",
		"Выполняет произвольный запрос на ЧТЕНИЕ к данным 1С:БИТ.ФИНАНС и возвращает результат в JSON."
			+ " Позволяет получить данные из любого справочника, документа или регистра —"
			+ " пользователей, группы доступа, роли, контрагентов, договоры, путевые листы и т.д."
			+ " Изменяющие конструкции (УНИЧТОЖИТЬ, ИЗМЕНИТЬ, ВЫПОЛНИТЬ и пр.) запрещены и отклоняются."
			+ " Ссылочные значения сериализуются как строковое представление.",
		СхемаПараметров
	);

КонецПроцедуры

// Выполняет произвольный запрос на чтение.
// Защита от изменения данных — двухуровневая: проверка текста запроса на
// запрещённые конструкции и отсутствие каких-либо вызовов записи объектов.
//
Функция ВыполнитьЗапросПоТексту(Аргументы) Экспорт

	ТекстЗапроса = "";
	Если Аргументы.Свойство("query") Тогда
		ТекстЗапроса = Аргументы.query;
	ИначеЕсли Аргументы.Свойство("query_text") Тогда
		ТекстЗапроса = Аргументы.query_text;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ВызватьИсключение "Не указан текст запроса (параметр query)";
	КонецЕсли;

	Лимит = ЧислоИзЗначения(?(Аргументы.Свойство("limit"), Аргументы.limit, 100), 100);
	Если Лимит <= 0 Или Лимит > 1000 Тогда
		Лимит = 100;
	КонецЕсли;

	// ── Проверка на изменяющие конструкции ───────────────────────────────────
	ПричинаОтказа = ПроверитьЗапросТолькоЧтение(ТекстЗапроса);
	Если ЗначениеЗаполнено(ПричинаОтказа) Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "ReadOnlyViolation");
		Итог.Вставить("message", ПричинаОтказа);
		Итог.Вставить("query",   ТекстЗапроса);
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	// ── Выполнение ───────────────────────────────────────────────────────────
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;

	// Параметры запроса (необязательный объект {имя: значение})
	Если Аргументы.Свойство("params") И Аргументы.params <> Неопределено Тогда
		Пары = Аргументы.params;
		Если ТипЗнч(Пары) = Тип("Структура") Или ТипЗнч(Пары) = Тип("Соответствие") Тогда
			Для Каждого КлючЗначение Из Пары Цикл
				Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "QueryError");
		Итог.Вставить("message", ОписаниеОшибки());
		Итог.Вставить("query",   ТекстЗапроса);
		Итог.Вставить("hint",    "Проверьте имена таблиц и полей через get_metadata_structure.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецПопытки;

	// Пакетный запрос возвращает результат последнего запроса пакета
	Если РезультатЗапроса = Неопределено Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "EmptyResult");
		Итог.Вставить("message", "Запрос не вернул результата (возможно, это только создание временной таблицы).");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	Таблица = РезультатЗапроса.Выгрузить();

	// ── Формирование ответа ──────────────────────────────────────────────────
	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Счетчик = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Счетчик >= Лимит Тогда
			Прервать;
		КонецЕсли;

		Запись = Новый Соответствие;
		Для Каждого ИмяКолонки Из Колонки Цикл
			Запись.Вставить(ИмяКолонки, ЗначениеЯчейкиВJSON(СтрокаТаблицы[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(Запись);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("columns",        Колонки);
	Итог.Вставить("count",          Строки.Количество());
	Итог.Вставить("total_in_result", Таблица.Количество());
	Итог.Вставить("truncated",      Таблица.Количество() > Строки.Количество());
	Итог.Вставить("rows",           Строки);
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

// Проверяет, что запрос не содержит изменяющих или опасных конструкций.
// Возвращает пустую строку если запрос допустим, иначе — причину отказа.
//
// Язык запросов 1С сам по себе не может изменять данные, но:
//  - УНИЧТОЖИТЬ удаляет временные таблицы (безвредно, но и не нужно);
//  - конструкции вида ВЫПОЛНИТЬ/Выполнить недопустимы в запросе, однако
//    их наличие сигнализирует о попытке инъекции — отклоняем явно;
//  - запрос обязан начинаться с ВЫБРАТЬ (либо с объявления временной таблицы).
//
Функция ПроверитьЗапросТолькоЧтение(Знач ТекстЗапроса)

	Текст = ВРег(СокрЛП(ТекстЗапроса));

	// Вырезаем комментарии ДО остальных проверок. Без этого шага текст
	// «ВЫБРАТЬ 1 // DROP» проходил фильтр, а «/* */» позволял спрятать
	// произвольную конструкцию от проверки на запрещённые слова.
	Текст = УдалитьКомментарии(Текст);

	// Убираем строковые литералы, чтобы не ловить ключевые слова внутри них.
	// Разделяем по кавычке: чётные фрагменты (0,2,4...) — вне литерала,
	// нечётные — внутри и заменяются пробелом.
	// Раньше здесь был посимвольный цикл с конкатенацией БезЛитералов + Символ —
	// классическая O(n²): для запроса в 5000 символов ~12.5 млн операций копирования.
	Фрагменты = СтрРазделить(Текст, """", Истина);
	ЧастиБезЛитералов = Новый Массив;
	Для Индекс = 0 По Фрагменты.ВГраница() Цикл
		Если Индекс % 2 = 0 Тогда
			ЧастиБезЛитералов.Добавить(Фрагменты[Индекс]);
		Иначе
			ЧастиБезЛитералов.Добавить(" ");
		КонецЕсли;
	КонецЦикла;
	БезЛитералов = СтрСоединить(ЧастиБезЛитералов, " ");

	// Запрос должен начинаться с ВЫБРАТЬ (регистр уже приведён)
	Если Лев(СокрЛП(БезЛитералов), 7) <> "ВЫБРАТЬ" Тогда
		Возврат "Разрешены только запросы на чтение: текст должен начинаться с ВЫБРАТЬ.";
	КонецЕсли;

	// Запрещённые конструкции. Раньше делалось 14 полных сканов текста
	// (по одному СловоВстречается на каждое слово). Теперь — один проход:
	// разбиваем текст на токены и проверяем вхождение в набор запрещённых.
	ЗапрещенныеСлова = "УНИЧТОЖИТЬ,DROP,DELETE,INSERT,UPDATE,ALTER,CREATE,TRUNCATE,MERGE,GRANT,REVOKE,EXEC,EXECUTE,ВЫПОЛНИТЬ";
	НаборЗапрещенных = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить(ЗапрещенныеСлова, ",", Ложь) Цикл
		НаборЗапрещенных.Вставить(Слово, Истина);
	КонецЦикла;

	// Нормализуем разделители в пробел, затем один СтрРазделить
	Нормализованный = БезЛитералов;
	Для Каждого Разделитель Из СтрРазделить(",;()" + Символы.ПС + Символы.ВК + Символы.Таб, "", Ложь) Цикл
		Нормализованный = СтрЗаменить(Нормализованный, Разделитель, " ");
	КонецЦикла;

	Для Каждого Токен Из СтрРазделить(Нормализованный, " ", Ложь) Цикл
		Если НаборЗапрещенных[Токен] <> Неопределено Тогда
			Возврат "Запрос содержит недопустимую конструкцию '" + Токен
				+ "'. Разрешены только запросы на чтение (ВЫБРАТЬ).";
		КонецЕсли;
	КонецЦикла;

	// ── Защита персональных данных ───────────────────────────────────────────
	ПричинаПДн = ПроверитьЗапросНаПерсональныеДанные(БезЛитералов);
	Если ЗначениеЗаполнено(ПричинаПДн) Тогда
		Возврат ПричинаПДн;
	КонецЕсли;

	Возврат "";

КонецФункции

// Удаляет из текста запроса однострочные (//) и блочные (/* */) комментарии.
//
// Комментарий может скрыть от проверки любую конструкцию, поэтому убирается
// до анализа. Строковые литералы при этом сохраняются: последовательность //
// внутри кавычек — часть данных, а не комментарий.
//
Функция УдалитьКомментарии(Знач Текст)

	Результат      = "";
	ВнутриСтроки   = Ложь;
	ВнутриБлочного = Ложь;
	Позиция        = 1;
	Длина          = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		Символ    = Сред(Текст, Позиция, 1);
		Следующий = ?(Позиция < Длина, Сред(Текст, Позиция + 1, 1), "");

		Если ВнутриБлочного Тогда
			// Ищем закрывающую последовательность */
			Если Символ = "*" И Следующий = "/" Тогда
				ВнутриБлочного = Ложь;
				Позиция = Позиция + 2;
			Иначе
				Позиция = Позиция + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ВнутриСтроки Тогда
			// Внутри литерала комментарии не начинаются
			Результат = Результат + Символ;
			Если Символ = """" Тогда
				ВнутриСтроки = Ложь;
			КонецЕсли;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Символ = """" Тогда
			ВнутриСтроки = Истина;
			Результат = Результат + Символ;
			Позиция = Позиция + 1;
		ИначеЕсли Символ = "/" И Следующий = "/" Тогда
			// Однострочный комментарий — пропускаем до конца строки
			Пока Позиция <= Длина И Сред(Текст, Позиция, 1) <> Символы.ПС Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Результат = Результат + " ";
		ИначеЕсли Символ = "/" И Следующий = "*" Тогда
			ВнутриБлочного = Истина;
			Результат = Результат + " ";
			Позиция = Позиция + 2;
		Иначе
			Результат = Результат + Символ;
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, не запрашивает ли запрос персональные данные.
//
// Политика ИБ: ФИО, логины и контактные данные сотрудников не покидают 1С.
// Идентификация пользователей — только по ИдентификаторПользователяИБ (UID).
//
// Проверка сделана здесь, в BSL, а не на стороне Node: это единственная
// реальная граница доверия. Клиент MCP-сервера может сформировать любой текст
// запроса, и проверка «снаружи» обходится подключением к 1С напрямую.
//
// Логика двухуровневая:
//   1) таблицы-справочники физлиц закрыты целиком — из них любое обращение
//      к представлению даёт ФИО;
//   2) для остальных таблиц закрыты конкретные реквизиты-носители ПДн.
//
Функция ПроверитьЗапросНаПерсональныеДанные(Знач ТекстБезЛитералов)

	Текст = ТекстБезЛитералов;

	// ── 1. Полностью закрытые таблицы ────────────────────────────────────────
	// Обращение к ним всегда раскрывает ФИО или контактные данные.
	ЗакрытыеТаблицы = "СПРАВОЧНИК.ФИЗИЧЕСКИЕЛИЦА,СПРАВОЧНИК.СОТРУДНИКИ,"
		+ "СПРАВОЧНИК.КОНТАКТНЫЕЛИЦА,СПРАВОЧНИК.КОНТАКТНЫЕЛИЦАКОНТРАГЕНТОВ,"
		+ "РЕГИСТРСВЕДЕНИЙ.КОНТАКТНАЯИНФОРМАЦИЯ,РЕГИСТРСВЕДЕНИЙ.ПАСПОРТНЫЕДАННЫЕФИЗЛИЦ,"
		+ "РЕГИСТРСВЕДЕНИЙ.ФИОФИЗЛИЦ";

	Для Каждого Таблица Из СтрРазделить(ЗакрытыеТаблицы, ",", Ложь) Цикл
		Если СтрНайти(Текст, Таблица) > 0 Тогда
			Возврат "Запрос обращается к таблице '" + Таблица
				+ "', содержащей персональные данные. Доступ к ФИО, логинам и контактным "
				+ "данным сотрудников запрещён политикой безопасности. "
				+ "Для идентификации пользователей используйте ИдентификаторПользователяИБ "
				+ "и инструменты list_1c_users / get_user_rights / get_user_visas.";
		КонецЕсли;
	КонецЦикла;

	// ── 2. Реквизиты-носители ПДн ────────────────────────────────────────────
	// Справочник.Пользователи нужен для служебных полей (UID, признаки
	// недействительности), поэтому таблица открыта, а ПДн-реквизиты — нет.
	ЗакрытыеРеквизиты = "НАИМЕНОВАНИЕ,ПОЛНОЕНАИМЕНОВАНИЕ,ФИЗЛИЦО,ФИЗИЧЕСКОЕЛИЦО,"
		+ "ИМЯ,ФАМИЛИЯ,ОТЧЕСТВО,ФИО,ИМЯПОЛЬЗОВАТЕЛЯ,ЛОГИН,"
		+ "ТЕЛЕФОН,EMAIL,АДРЕС,ПАСПОРТ,СНИЛС,ИНН";

	// Ищем «Пользователи.<реквизит>» и «Пользователи КАК X ... X.<реквизит>».
	// Достаточно проверить, что в запросе одновременно есть таблица
	// Справочник.Пользователи и точечное обращение к закрытому реквизиту.
	Если СтрНайти(Текст, "СПРАВОЧНИК.ПОЛЬЗОВАТЕЛИ") > 0 Тогда
		Для Каждого Реквизит Из СтрРазделить(ЗакрытыеРеквизиты, ",", Ложь) Цикл
			Если СтрНайти(Текст, "." + Реквизит) > 0
				Или НачинаетсяССлова(Текст, Реквизит) Тогда
				Возврат "Запрос обращается к реквизиту '" + Реквизит
					+ "' справочника Пользователи — это персональные данные. "
					+ "Разрешены только служебные поля: "
					+ "ИдентификаторПользователяИБ, Недействителен, ПометкаУдаления. "
					+ "Идентификация сотрудников — по ИдентификаторПользователяИБ.";
			КонецЕсли;
		КонецЦикла;

		// Ссылка и ПРЕДСТАВЛЕНИЕ() раскрывают ФИО не хуже реквизита:
		// ссылочное значение сериализуется своим представлением, а у
		// справочника Пользователи представление — это ФИО сотрудника.
		// Поэтому «ВЫБРАТЬ Ссылка ИЗ Справочник.Пользователи» возвращал
		// «Лубягина Татьяна Николаевна», проходя проверку по реквизитам.
		Если НачинаетсяССлова(Текст, "ССЫЛКА")
			Или СтрНайти(Текст, ".ССЫЛКА") > 0
			Или СтрНайти(Текст, "ПРЕДСТАВЛЕНИЕ(") > 0 Тогда
			Возврат "Запрос обращается к ссылке или представлению справочника "
				+ "Пользователи — они раскрывают ФИО сотрудника. "
				+ "Разрешены только служебные поля: "
				+ "ИдентификаторПользователяИБ, Недействителен, ПометкаУдаления. "
				+ "Идентификация сотрудников — по ИдентификаторПользователяИБ.";
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Проверяет, встречается ли слово сразу после ВЫБРАТЬ (без префикса таблицы).
// Нужно для случая «ВЫБРАТЬ Наименование ИЗ Справочник.Пользователи»,
// где обращение к реквизиту идёт без точки.
//
Функция НачинаетсяССлова(Знач Текст, Знач Слово)

	Разделители = " ,;()" + Символы.ПС + Символы.ВК + Символы.Таб;
	Позиция = 1;

	Пока Истина Цикл
		Найдено = СтрНайти(Текст, Слово, НаправлениеПоиска.СНачала, Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		СимволДо     = ?(Найдено = 1, " ", Сред(Текст, Найдено - 1, 1));
		ПозицияПосле = Найдено + СтрДлина(Слово);
		СимволПосле  = ?(ПозицияПосле > СтрДлина(Текст), " ", Сред(Текст, ПозицияПосле, 1));

		// Точка перед словом означает «Таблица.Реквизит» — этот случай
		// разбирается отдельной проверкой выше, здесь он не наш.
		Если СимволДо <> "." И СтрНайти(Разделители, СимволДо) > 0
			И СтрНайти(Разделители, СимволПосле) > 0 Тогда
			Возврат Истина;
		КонецЕсли;

		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

// Приводит значение ячейки результата запроса к JSON-совместимому виду.
// Ссылки отдаём строковым представлением — иначе агент получит служебный GUID.
Функция ЗначениеЯчейкиВJSON(Знач Значение)

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=""гггг-ММ-дд ЧЧ:мм:сс"""), "");
	КонецЕсли;

	Попытка
		Возврат Лев(Строка(Значение), 500);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти


#Область ВспомогательныеФункцииРежимовВиз

// ─── Вспомогательные функции ─────────────────────────────────────────────────

// Приводит значение правила условия к строке, пригодной для JSON.
// Числа отдаём без группировки — иначе «30 000 000» ломает машинный разбор.
Функция ЗначениеПравилаВСтроку(Знач Значение)

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат Формат(Значение, "ЧГ=0; ЧДЦ=2");
		ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат ?(Значение, "Да", "Нет");
		ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
			Возврат Формат(Значение, "ДФ=гггг-ММ-дд");
		КонецЕсли;
		Возврат Лев(СокрЛП(Строка(Значение)), 150);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Собирает человекочитаемую расшифровку правила условия из строк ТЧ Условия.
// Пример результата: "СуммаДокумента Больше или равно 30000000 И СуммаДокумента Меньше 150000000".
// Именно это, а не наименование условия, отражает реальные пороги по суммам.
Функция ТекстПравилУсловия(Знач МассивПравил, Знач ПроизвольноеУсловие)

	Если МассивПравил = Неопределено Или МассивПравил.Количество() = 0 Тогда
		// Правил в ТЧ нет — возможно, условие задано произвольным выражением
		Возврат ?(ЗначениеЗаполнено(ПроизвольноеУсловие), СокрЛП(ПроизвольноеУсловие), "");
	КонецЕсли;

	Части = Новый Массив;
	Индекс = 0;
	Для Каждого Правило Из МассивПравил Цикл
		Фрагмент = СокрЛП(Правило["bracket_open"])
			+ СокрЛП(Правило["property"])
			+ " " + СокрЛП(Правило["comparison"])
			+ " " + СокрЛП(Правило["value"])
			+ СокрЛП(Правило["bracket_close"]);

		Части.Добавить(СокрЛП(Фрагмент));

		// Связка с последующим правилом (И / ИЛИ)
		Индекс = Индекс + 1;
		Если Индекс < МассивПравил.Количество() Тогда
			Связка = СокрЛП(Правило["join"]);
			Если Связка = "Логическое сложение" Или Связка = "ЛогическоеСложение" Тогда
				Части.Добавить("ИЛИ");
			Иначе
				Части.Добавить("И");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Решает, искать ли визу по вхождению в наименование.
//
// Литеры виз короткие («ОД», «РПО», «УЭБ»), и поиск подстрокой по наименованию
// даёт ложные срабатывания: «ОД» находит «Рук-ОВ-ОД-итель проекта».
// Поэтому короткий ввод (<= 5 символов без пробелов) трактуем строго как
// литеру/кодификатор, а поиск по наименованию включаем только для более
// длинных значений вида «Операционный директор».
Функция ИскатьВизуПоНаименованию(Знач КодВизы)

	Текст = СокрЛП(Строка(КодВизы));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Есть пробел — это точно наименование, не литера
	Если СтрНайти(Текст, " ") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрДлина(Текст) > 5;

КонецФункции

// Готовит шаблон для оператора ПОДОБНО: экранирует служебные символы
// («%», «_», «[», «\») спецсимволом и обрамляет строку процентами.
// Без экранирования пользовательский ввод вида «100%» ломает поиск.
// В запросе такой шаблон применяется как: Поле ПОДОБНО &Шаблон СПЕЦСИМВОЛ "\"
Функция ШаблонПодобно(Знач Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "%";
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Текст = СтрЗаменить(Текст, "\", "\\");
	Текст = СтрЗаменить(Текст, "%", "\%");
	Текст = СтрЗаменить(Текст, "_", "\_");
	Текст = СтрЗаменить(Текст, "[", "\[");

	Возврат "%" + Текст + "%";

КонецФункции

// Читаемая подпись перехода (значение условия на исходящей ветке).
// Тип составной (тысячи типов) — приводим к строке безопасно.
Функция ПредставлениеУсловия(Знач Значение)

	Если Значение = Неопределено Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Возврат ?(Значение, "Да", "Нет");
		КонецЕсли;
		Возврат Лев(Строка(Значение), 100);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Возвращает синоним (или имя) типа объекта метаданных
Функция ИмяТипаОбъекта(Объект)

	Если Объект = Неопределено Или Не ЗначениеЗаполнено(Объект) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		МетаОбъекта = Объект.Метаданные();
		Если ЗначениеЗаполнено(МетаОбъекта.Синоним) Тогда
			Возврат МетаОбъекта.Синоним;
		КонецЕсли;
		Возврат МетаОбъекта.Имя;
	Исключение
		Возврат Строка(ТипЗнч(Объект));
	КонецПопытки;

КонецФункции

// Преобразует строку "ГГГГ-ММ-ДД" в Дату; при ошибке возвращает пустую дату
Функция ДатаИзСтроки(СтрДата)

	Если Не ЗначениеЗаполнено(СтрДата) Или ТипЗнч(СтрДата) <> Тип("Строка") Тогда
		Возврат '00010101';
	КонецЕсли;

	Части = СтрРазделить(СокрЛП(СтрДата), "-", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Преобразует строку "ГГГГ-ММ-ДД" в конец дня (23:59:59).
// Нужно для верхней границы периода — иначе документы за последний день
// с ненулевым временем не попадут в выборку.
Функция КонецДняИзСтроки(СтрДата)

	ЗначениеДаты = ДатаИзСтроки(СтрДата);
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат '00010101';
	КонецЕсли;

	Возврат КонецДня(ЗначениеДаты);

КонецФункции

// Форматирует дату в ISO; для пустой даты возвращает пустую строку
Функция ДатаВСтроку(Знач ЗначениеДаты)

	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат "";
	КонецЕсли;

	// Время значимо для виз (дата установки, крайний срок) — отдаём ISO с временем
	Возврат Формат(ЗначениеДаты, "ДФ=""гггг-ММ-дд ЧЧ:мм:сс""");

КонецФункции

// Приводит UID к каноничному строковому виду с дефисами.
// Принимает и hex из 32 символов, и UUID с дефисами.
Функция UUIDВСтроку(Знач UIDСтрока)

	Возврат HexВUUID(СокрЛП(Строка(UIDСтрока)));

КонецФункции

// Находит пользователя по ИдентификаторПользователяИБ.
// Общий helper: одинаковая обработка UID нужна и в rights, и в check_document_access.
//
// Параметры:
//  UIDСтрока - Строка - UUID с дефисами либо hex из 32 символов
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.Пользователи, Неопределено - найденный пользователь
//   * Ошибка - Строка - "" при успехе, иначе код: InvalidUID | UserNotFound
//
Функция НайтиПользователяПоUID(Знач UIDСтрока)

	Результат = Новый Структура("Ссылка, Ошибка", Неопределено, "");

	Текст = СокрЛП(Строка(UIDСтрока));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Результат.Ошибка = "InvalidUID";
		Возврат Результат;
	КонецЕсли;

	УИДЗначение = Неопределено;
	Попытка
		УИДЗначение = Новый УникальныйИдентификатор(HexВUUID(Текст));
	Исключение
		Результат.Ошибка = "InvalidUID";
		Возврат Результат;
	КонецПопытки;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Польз.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Польз
	|ГДЕ
	|	Польз.ИдентификаторПользователяИБ = &УИД
	|	И НЕ Польз.ПометкаУдаления");
	Запрос.УстановитьПараметр("УИД", УИДЗначение);

	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		Результат.Ошибка = "UserNotFound";
		Возврат Результат;
	КонецЕсли;

	Результат.Ссылка = Таблица[0].Ссылка;
	Возврат Результат;

КонецФункции

// Формирует JSON-ответ об ошибке поиска пользователя по UID.
//
// Параметры:
//  РезультатПоиска - Структура - результат НайтиПользователяПоUID
//  UIDСтрока       - Строка    - исходное значение из аргументов
//  Режим           - Строка    - режим инструмента, для контекста в ответе
//
Функция ОтветОбОшибкеПоискаПользователя(Знач РезультатПоиска, Знач UIDСтрока, Знач Режим = "")

	Итог = Новый Соответствие;
	Если ЗначениеЗаполнено(Режим) Тогда
		Итог.Вставить("mode", Режим);
	КонецЕсли;
	Итог.Вставить("error",    РезультатПоиска.Ошибка);
	Итог.Вставить("user_uid", СокрЛП(Строка(UIDСтрока)));

	Если РезультатПоиска.Ошибка = "InvalidUID" Тогда
		Итог.Вставить("message", "Неверный формат user_uid: '" + СокрЛП(Строка(UIDСтрока)) + "'.");
		Итог.Вставить("hint",    "Ожидается UUID вида 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'"
			+ " или hex из 32 символов. Получить UID: инструмент list_1c_users.");
	Иначе
		Итог.Вставить("message", "Пользователь не найден по ИдентификаторПользователяИБ.");
		Итог.Вставить("hint",    "Проверьте UID через инструмент list_1c_users.");
	КонецЕсли;

	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

// Безопасное приведение к числу
Функция ЧислоИзЗначения(Знач Значение, Знач ЗначениеПоУмолчанию)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

#КонецОбласти


#Область Инструмент_get_user_rights

// ─── Инструмент get_user_rights ──────────────────────────────────────────────
//
// Возвращает группы доступа и профили для пользователя по UID
// (ИдентификаторПользователяИБ из Справочник.Пользователи).
// ФИО НЕ передаётся — только UID, профили, группы и виды доступа.
//
// Схема идентификации без персональных данных:
//   UID уникален для каждого объекта и каждой базы 1С.
//   Деанонимизация возможна только при прямом доступе к базе.
//   LLM видит только: UID → группы → профили → права на объекты.
//

Процедура ЗарегистрироватьИнструментGetUserRights(ТаблицаИнструментов)

	МассивПараметров = Новый Массив;

	// Параметр user_ref — ссылка на пользователя в формате Справочник.Пользователи?ref=<hex>
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"user_ref",
		"string",
		"Ссылка на пользователя в формате 'Справочник.Пользователи?ref=<hex>'."
			+ " Например: 'Справочник.Пользователи?ref=8aa40050569b551b11f08de377fb12a5'."
			+ " ФИО не передаётся — только ссылка для анонимного поиска в базе.",
		,
		Истина
	));

	// Параметр include_access_values
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"include_access_values",
		"string",
		"true — включать виды доступа группы (ЦФО, склады, подразделения и т.д.) в ответ. По умолчанию false.",
		"false",
		,
		"true,false"
	));

	// Параметр limit
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit",
		"number",
		"Максимум строк результата (по умолчанию 50, максимум 200)",
		50
	));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	mcp_Метаданные.ДобавитьИнструмент(
		ТаблицаИнструментов,
		"get_user_rights",
		"Возвращает группы доступа и профили пользователя 1С по ссылке (user_ref)."
			+ " Формат ссылки: 'Справочник.Пользователи?ref=<hex>'."
			+ " ФИО и контактные данные НЕ передаются — только ссылка для анонимного поиска."
			+ " Показывает: к каким группам доступа относится пользователь, какой профиль у каждой группы,"
			+ " виды доступа (ЦФО, склады, подразделения).",
		СхемаПараметров
	);

КонецПроцедуры

// Извлекает hex-строку ref из URI вида 'Справочник.Пользователи?ref=<hex>'
// или принимает hex-строку напрямую (без префикса).
// Возвращает строку hex или "" если не удалось разобрать.
Функция ИзвлечьRefИзURI(Знач URIСтрока)

	Текст = СокрЛП(Строка(URIСтрока));
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	// Ищем параметр ref=
	ПозицияRef = СтрНайти(НРег(Текст), "ref=");
	Если ПозицияRef > 0 Тогда
		// Берём всё после "ref="
		HexСтрока = Сред(Текст, ПозицияRef + 4);
		// Убираем лишние символы после hex (например &param2=...)
		ПозицияАмп = СтрНайти(HexСтрока, "&");
		Если ПозицияАмп > 0 Тогда
			HexСтрока = Лев(HexСтрока, ПозицияАмп - 1);
		КонецЕсли;
		Возврат СокрЛП(HexСтрока);
	КонецЕсли;

	// Если ref= не найден — предполагаем, что передан чистый hex
	Возврат Текст;

КонецФункции

// Преобразует 32-символьный hex в стандартный формат UUID (с дефисами)
// Формат 1С: 8aa40050569b551b11f08de377fb12a5 → 8aa40050-569b-551b-11f0-8de377fb12a5
// Если строка уже содержит дефисы — возвращаем как есть.
Функция HexВUUID(Знач HexСтрока)

	Текст = СокрЛП(HexСтрока);
	// Уже в формате UUID с дефисами
	Если СтрДлина(Текст) = 36 И СтрНайти(Текст, "-") > 0 Тогда
		Возврат Текст;
	КонецЕсли;

	// Чистый hex 32 символа → UUID
	Если СтрДлина(Текст) = 32 Тогда
		Возврат Лев(Текст, 8) + "-"
			+ Сред(Текст, 9, 4) + "-"
			+ Сред(Текст, 13, 4) + "-"
			+ Сред(Текст, 17, 4) + "-"
			+ Прав(Текст, 12);
	КонецЕсли;

	// Вернём как есть — пусть дальше выдаст ошибку парсинга
	Возврат Текст;

КонецФункции

Функция ВыполнитьGetUserRights(Аргументы)

	УРЛСсылки = ?(Аргументы.Свойство("user_ref"), Аргументы.user_ref, "");
	ВкАК      = ?(Аргументы.Свойство("include_access_values"), Аргументы.include_access_values, "false") = "true";
	Лимит     = ЧислоИзЗначения(?(Аргументы.Свойство("limit"), Аргументы.limit, 50), 50);
	Если Лимит <= 0 Или Лимит > 200 Тогда
		Лимит = 50;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(УРЛСсылки) Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "MissingParameter");
		Итог.Вставить("message", "Необходимо передать user_ref — ссылку на пользователя.");
		Итог.Вставить("hint",    "Формат: 'Справочник.Пользователи?ref=<hex>', например 'Справочник.Пользователи?ref=8aa40050569b551b11f08de377fb12a5'.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	// Извлекаем hex из URI и преобразуем в UUID
	HexСтрока = ИзвлечьRefИзURI(УРЛСсылки);
	Если Не ЗначениеЗаполнено(HexСтрока) Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "InvalidRef");
		Итог.Вставить("message", "Не удалось извлечь ref из: " + УРЛСсылки);
		Итог.Вставить("hint",    "Передайте ссылку в формате 'Справочник.Пользователи?ref=<hex>'.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	UUIDСтрока = HexВUUID(HexСтрока);

	// Парсим UUID в УникальныйИдентификатор для поиска в базе
	УИДЗначение = Неопределено;
	Попытка
		УИДЗначение = Новый УникальныйИдентификатор(UUIDСтрока);
	Исключение
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "InvalidRef");
		Итог.Вставить("message", "Неверный формат ссылки. hex='" + HexСтрока + "', uuid='" + UUIDСтрока + "'.");
		Итог.Вставить("hint",    "Ожидается hex 32 символа (без дефисов) или UUID с дефисами.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецПопытки;

	// Поиск по ИдентификаторПользователяИБ — статичный UUID, присваивается при создании записи.
	// hex из user_ref интерпретируется как ИдентификаторПользователяИБ (тип УникальныйИдентификатор).

	ЗапросПользователя = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователь.Ссылка                        КАК Ссылка,
	|	ЕСТЬNULL(Пользователь.Подразделение.Наименование, """") КАК ПодразделениеНазвание,
	|	ЕСТЬNULL(Пользователь.гти_СтруктурноеПодразделение.Наименование, """") КАК СтруктурноеПодразделение,
	|	Пользователь.Недействителен                КАК Недействителен,
	|	Пользователь.Служебный                     КАК Служебный
	|ИЗ
	|	Справочник.Пользователи КАК Пользователь
	|ГДЕ
	|	Пользователь.ИдентификаторПользователяИБ = &УИД
	|	И НЕ Пользователь.ПометкаУдаления");

	ЗапросПользователя.УстановитьПараметр("УИД", УИДЗначение);
	ТаблицаПользователя = ЗапросПользователя.Выполнить().Выгрузить();

	Если ТаблицаПользователя.Количество() = 0 Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",    "UserNotFound");
		Итог.Вставить("user_ref", УРЛСсылки);
		Итог.Вставить("message",  "Пользователь не найден: " + УРЛСсылки);
		Итог.Вставить("hint",     "hex в user_ref — ИдентификаторПользователяИБ без дефисов. "
			+ "Получить: ВЫБРАТЬ ИдентификаторПользователяИБ ИЗ Справочник.Пользователи "
			+ "ГДЕ Наименование ПОДОБНО ""%Имя%""");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	СтрПользователь = ТаблицаПользователя[0];
	СсылкаПользователя = СтрПользователь.Ссылка;

	// 2. Группы доступа пользователя
	ТекстГрупп =
	"ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	ГД.Наименование                            КАК ГруппаДоступа,
	|	ЕСТЬNULL(ГД.Профиль.Наименование, """")    КАК Профиль,
	|	ЕСТЬNULL(ГД.Комментарий, """")             КАК Комментарий,
	|	ТЧ.СрокДействия                            КАК СрокДействия
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГД
	|		ПО ГД.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	ТЧ.Пользователь = &Пользователь
	|	И НЕ ГД.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ГД.Наименование";

	ЗапросГрупп = Новый Запрос;
	ЗапросГрупп.Текст = СтрЗаменить(ТекстГрупп, "&&Лимит", Формат(Лимит, "ЧГ=0"));
	ЗапросГрупп.УстановитьПараметр("Пользователь", СсылкаПользователя);
	ТаблицаГрупп = ЗапросГрупп.Выполнить().Выгрузить();

	// 3. Виды доступа групп (опционально)
	ВидыДоступаМап = Новый Соответствие;
	Если ВкАК Тогда
		// Получаем ссылки групп для фильтрации
		СсылкиГрупп = Новый Массив;
		ЗапросСсылок = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ТЧ.Ссылка КАК Ссылка
		|ИЗ Справочник.ГруппыДоступа.Пользователи КАК ТЧ
		|ГДЕ ТЧ.Пользователь = &Пользователь И НЕ ТЧ.Ссылка.ПометкаУдаления");
		ЗапросСсылок.УстановитьПараметр("Пользователь", СсылкаПользователя);
		ТаблицаСсылок = ЗапросСсылок.Выполнить().Выгрузить();
		Для Каждого Стр Из ТаблицаСсылок Цикл
			СсылкиГрупп.Добавить(Стр.Ссылка);
		КонецЦикла;

		Если СсылкиГрупп.Количество() > 0 Тогда
			ЗапросВД = Новый Запрос(
			"ВЫБРАТЬ
			|	ВД.Ссылка                              КАК ГруппаСсылка,
			|	ВД.Ссылка.Наименование                 КАК ГруппаНазвание,
			|	ПРЕДСТАВЛЕНИЕ(ВД.ВидДоступа)           КАК ВидДоступа,
			|	ВД.ВсеРазрешены                        КАК ВсеРазрешены
			|ИЗ
			|	Справочник.ГруппыДоступа.ВидыДоступа КАК ВД
			|ГДЕ
			|	ВД.Ссылка В (&СсылкиГрупп)");
			ЗапросВД.УстановитьПараметр("СсылкиГрупп", СсылкиГрупп);
			ТаблицаВД = ЗапросВД.Выполнить().Выгрузить();

			Для Каждого Стр Из ТаблицаВД Цикл
				Ключ = Стр.ГруппаНазвание;
				Список = ВидыДоступаМап[Ключ];
				Если Список = Неопределено Тогда
					Список = Новый Массив;
					ВидыДоступаМап.Вставить(Ключ, Список);
				КонецЕсли;
				МапВД = Новый Соответствие;
				МапВД.Вставить("access_kind",   Стр.ВидДоступа);
				МапВД.Вставить("all_allowed",   Стр.ВсеРазрешены);
				Список.Добавить(МапВД);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// 4. Сборка ответа
	ГруппыМассив = Новый Массив;
	Для Каждого Стр Из ТаблицаГрупп Цикл
		МапГруппы = Новый Соответствие;
		МапГруппы.Вставить("group",    Стр.ГруппаДоступа);
		МапГруппы.Вставить("profile",  Стр.Профиль);
		МапГруппы.Вставить("comment",  Стр.Комментарий);
		СрокД = ?(ЗначениеЗаполнено(Стр.СрокДействия), Формат(Стр.СрокДействия, "ДФ=гггг-ММ-дд"), "");
		МапГруппы.Вставить("expires",  СрокД);
		Если ВкАК Тогда
			МапГруппы.Вставить("access_kinds", ?(ВидыДоступаМап[Стр.ГруппаДоступа] <> Неопределено,
				ВидыДоступаМап[Стр.ГруппаДоступа], Новый Массив));
		КонецЕсли;
		ГруппыМассив.Добавить(МапГруппы);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("user_ref",             УРЛСсылки);
	Итог.Вставить("department",            СтрПользователь.ПодразделениеНазвание);
	Итог.Вставить("structural_department", СтрПользователь.СтруктурноеПодразделение);
	Итог.Вставить("is_active",             Не СтрПользователь.Недействителен);
	Итог.Вставить("is_service",            СтрПользователь.Служебный);
	Итог.Вставить("groups_count",          ГруппыМассив.Количество());
	Итог.Вставить("groups",               ГруппыМассив);
	Итог.Вставить("privacy_note",
		"ФИО не передаётся. Поиск выполняется по ссылке (ref) в Справочник.Пользователи."
		+ " Деанонимизация требует прямого доступа к базе 1С.");
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

#Область Инструмент_get_user_visas

// ─── Инструмент get_user_visas ────────────────────────────────────────────────
//
// Возвращает визы согласования, на которые назначен пользователь,
// через его группы доступа. Поиск внутри 1С по ИдентификаторПользователяИБ.
// ФИО и персональные данные НЕ передаются — только визы и роли.
//

Процедура ЗарегистрироватьИнструментGetUserVisas(ТаблицаИнструментов)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"user_uid",
		"string",
		"ИдентификаторПользователяИБ в формате UUID с дефисами, например '490933bc-311e-41d5-bcc4-eeb4b996ebf5'."
		+ " ФИО не передаётся — только анонимный идентификатор.",
		,
		Истина
	));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	mcp_Метаданные.ДобавитьИнструмент(
		ТаблицаИнструментов,
		"get_user_visas",
		"Возвращает визы согласования пользователя 1С через его группы доступа."
		+ " Принимает ИдентификаторПользователяИБ (UUID). Все вычисления внутри 1С."
		+ " ФИО и персональные данные НЕ передаются — только визы, литеры и условия.",
		СхемаПараметров
	);

КонецПроцедуры

Функция ВыполнитьGetUserVisas(Аргументы)

	// Получаем UID из аргументов
	UUIDСтрока = СокрЛП(?(Аргументы.Свойство("user_uid"), Аргументы.user_uid, ""));

	Если Не ЗначениеЗаполнено(UUIDСтрока) Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "MissingParameter");
		Итог.Вставить("message", "Необходимо передать user_uid — ИдентификаторПользователяИБ.");
		Итог.Вставить("hint",    "Формат: '490933bc-311e-41d5-bcc4-eeb4b996ebf5'."
			+ " Получить: ВЫБРАТЬ ИдентификаторПользователяИБ ИЗ Справочник.Пользователи"
			+ " ГДЕ Наименование ПОДОБНО ""%Имя%""");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	// Парсим UUID
	УИДЗначение = Неопределено;
	Попытка
		УИДЗначение = Новый УникальныйИдентификатор(UUIDСтрока);
	Исключение
		Итог = Новый Соответствие;
		Итог.Вставить("error",   "InvalidUID");
		Итог.Вставить("message", "Неверный формат UUID: '" + UUIDСтрока + "'.");
		Итог.Вставить("hint",    "Ожидается формат 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецПопытки;

	// Шаг 1: находим ссылку на пользователя по ИдентификаторПользователяИБ
	ЗапросПольз = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Польз.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Польз
	|ГДЕ
	|	Польз.ИдентификаторПользователяИБ = &УИД
	|	И НЕ Польз.ПометкаУдаления");
	ЗапросПольз.УстановитьПараметр("УИД", УИДЗначение);
	ТаблицаПольз = ЗапросПольз.Выполнить().Выгрузить();

	Если ТаблицаПольз.Количество() = 0 Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("error",    "UserNotFound");
		Итог.Вставить("user_uid", UUIDСтрока);
		Итог.Вставить("message",  "Пользователь не найден по ИдентификаторПользователяИБ.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	СсылкаПользователя = ТаблицаПольз[0].Ссылка;

	// Шаг 2: находим визы пользователя напрямую из РС.бит_ПраваУстановкиВиз.
	// Поле Пользователь — составной тип: Справочник.Пользователи или Группа пользователей.
	// Ищем записи где Пользователь = конкретный Справочник.Пользователи.
	ЗапросВиз = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Права.Виза.Наименование           КАК ВизаНаименование,
	|	Права.Виза.Литера                 КАК Литера,
	|	Права.ПользовательскоеУсловие     КАК Условие,
	|	ЕСТЬNULL(Права.Замещаемый.Наименование, """") КАК Замещаемый
	|ИЗ
	|	РегистрСведений.бит_ПраваУстановкиВиз КАК Права
	|ГДЕ
	|	Права.Пользователь = &Пользователь
	|УПОРЯДОЧИТЬ ПО
	|	ВизаНаименование");
	ЗапросВиз.УстановитьПараметр("Пользователь", СсылкаПользователя);
	ТаблицаВиз = ЗапросВиз.Выполнить().Выгрузить();

	ВизыМассив = Новый Массив;
	Для Каждого Стр Из ТаблицаВиз Цикл
		МапВизы = Новый Соответствие;
		МапВизы.Вставить("visa_name",  Стр.ВизаНаименование);
		МапВизы.Вставить("letter",     Стр.Литера);
		МапВизы.Вставить("condition",  Стр.Условие);
		МапВизы.Вставить("substitute", Стр.Замещаемый);
		ВизыМассив.Добавить(МапВизы);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("user_uid",     UUIDСтрока);
	Итог.Вставить("visas_count",  ВизыМассив.Количество());
	Итог.Вставить("visas",        ВизыМассив);
	Итог.Вставить("privacy_note", "ФИО не передаётся. Поиск по ИдентификаторПользователяИБ внутри 1С.");
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

#КонецОбласти

#Область Инструмент_get_users

// ─── Инструмент get_users ─────────────────────────────────────────────────────
//
// Список пользователей базы БЕЗ ФИО. Возвращает только:
// UID (ИдентификаторПользователяИБ), должность, подразделение, признаки.
// Поиск по имени выполняется ВНУТРИ 1С — наружу имя не передаётся.
//

Процедура ЗарегистрироватьИнструментGetUsers(ТаблицаИнструментов)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"search", "string",
		"Поиск по ФИО или логину (частичное совпадение). Выполняется внутри 1С,"
		+ " ФИО в ответе НЕ возвращается — только UID.", ""));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"department", "string",
		"Фильтр по подразделению (частичное совпадение).", ""));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number",
		"Максимум записей (по умолчанию 50, максимум 200).", 50));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"include_inactive", "string",
		"true — включать недействительных пользователей. По умолчанию false.",
		"false", , "true,false"));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	mcp_Метаданные.ДобавитьИнструмент(
		ТаблицаИнструментов,
		"get_users",
		"Список пользователей 1С БЕЗ ФИО. Возвращает: UID (ИдентификаторПользователяИБ),"
		+ " должность, подразделение, структурное подразделение, признаки активности."
		+ " ФИО и контактные данные НЕ передаются. Поиск по имени выполняется внутри 1С."
		+ " Полученный UID используйте в get_user_rights и get_user_visas.",
		СхемаПараметров
	);

КонецПроцедуры

Функция ВыполнитьGetUsers(Аргументы)

	Поиск       = СокрЛП(?(Аргументы.Свойство("search"),     Аргументы.search,     ""));
	Подразд     = СокрЛП(?(Аргументы.Свойство("department"), Аргументы.department, ""));
	ВклНеактив  = ?(Аргументы.Свойство("include_inactive"),
	                СокрЛП(НРег(Строка(Аргументы.include_inactive))), "false") = "true";
	Лимит       = Цел(ЧислоИзЗначения(?(Аргументы.Свойство("limit"), Аргументы.limit, 50), 50));
	Если Лимит <= 0 Или Лимит > 200 Тогда
		Лимит = 50;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	Польз.ИдентификаторПользователяИБ КАК УИД,
	|	ЕСТЬNULL(Польз.Подразделение.Наименование, """")                 КАК Подразделение,
	|	ЕСТЬNULL(Польз.гти_СтруктурноеПодразделение.Наименование, """")  КАК СтруктурноеПодразделение,
	|	Польз.Недействителен КАК Недействителен,
	|	Польз.Служебный      КАК Служебный
	|ИЗ
	|	Справочник.Пользователи КАК Польз
	|ГДЕ
	|	НЕ Польз.ПометкаУдаления
	|	И (&ВключатьНеактивных ИЛИ НЕ Польз.Недействителен)
	|	И (&ПоискПустой  ИЛИ Польз.Наименование ПОДОБНО &ШаблонПоиска)
	|	И (&ПодраздПустое ИЛИ Польз.Подразделение.Наименование ПОДОБНО &ШаблонПодразд)
	|УПОРЯДОЧИТЬ ПО
	|	Польз.Наименование";

	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "&&Лимит", Формат(Лимит, "ЧГ=0")));
	Запрос.УстановитьПараметр("ВключатьНеактивных", ВклНеактив);
	Запрос.УстановитьПараметр("ПоискПустой",        Не ЗначениеЗаполнено(Поиск));
	Запрос.УстановитьПараметр("ШаблонПоиска",       "%" + Поиск + "%");
	Запрос.УстановитьПараметр("ПодраздПустое",      Не ЗначениеЗаполнено(Подразд));
	Запрос.УстановитьПараметр("ШаблонПодразд",      "%" + Подразд + "%");

	Таблица = Запрос.Выполнить().Выгрузить();

	Массив = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Мап = Новый Соответствие;
		Мап.Вставить("user_uid",              Строка(Стр.УИД));
		Мап.Вставить("department",            Стр.Подразделение);
		Мап.Вставить("structural_department", Стр.СтруктурноеПодразделение);
		Мап.Вставить("is_active",             Не Стр.Недействителен);
		Мап.Вставить("is_service",            Стр.Служебный);
		Массив.Добавить(Мап);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("users_count",  Массив.Количество());
	Итог.Вставить("users",        Массив);
	Итог.Вставить("limit",        Лимит);
	Итог.Вставить("privacy_note",
		"ФИО и логины НЕ передаются. Идентификация только по user_uid."
		+ " Используйте user_uid в get_user_rights / get_user_visas.");
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

#КонецОбласти

#Область Инструмент_get_access_groups

// ─── Инструмент get_access_groups ─────────────────────────────────────────────
//
// Группы доступа базы: наименование, профиль, количество участников.
// Опционально — список ролей профиля. ФИО участников НЕ передаётся.
//

Процедура ЗарегистрироватьИнструментGetAccessGroups(ТаблицаИнструментов)

	МассивПараметров = Новый Массив;

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"group_name", "string",
		"Фильтр по названию группы доступа (частичное совпадение).", ""));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"user_uid", "string",
		"ИдентификаторПользователяИБ (UUID) — вернуть только группы этого пользователя.", ""));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"include_roles", "string",
		"true — включать список ролей профиля каждой группы. По умолчанию false.",
		"false", , "true,false"));

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number",
		"Максимум групп (по умолчанию 50, максимум 200).", 50));

	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	mcp_Метаданные.ДобавитьИнструмент(
		ТаблицаИнструментов,
		"get_access_groups",
		"Группы доступа 1С: наименование, профиль, количество участников."
		+ " Опционально — роли профиля (include_roles=true)."
		+ " Можно отфильтровать по названию группы или по user_uid конкретного пользователя."
		+ " ФИО участников НЕ передаётся.",
		СхемаПараметров
	);

КонецПроцедуры

Функция ВыполнитьGetAccessGroups(Аргументы)

	ИмяГруппы = СокрЛП(?(Аргументы.Свойство("group_name"), Аргументы.group_name, ""));
	УИДСтрока = СокрЛП(?(Аргументы.Свойство("user_uid"),   Аргументы.user_uid,   ""));
	ВклРоли   = ?(Аргументы.Свойство("include_roles"),
	              СокрЛП(НРег(Строка(Аргументы.include_roles))), "false") = "true";
	Лимит     = Цел(ЧислоИзЗначения(?(Аргументы.Свойство("limit"), Аргументы.limit, 50), 50));
	Если Лимит <= 0 Или Лимит > 200 Тогда
		Лимит = 50;
	КонецЕсли;

	// Если задан user_uid — разбираем его в УникальныйИдентификатор
	ФильтрПоПользователю = ЗначениеЗаполнено(УИДСтрока);
	УИДЗначение = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если ФильтрПоПользователю Тогда
		Попытка
			УИДЗначение = Новый УникальныйИдентификатор(HexВUUID(ИзвлечьRefИзURI(УИДСтрока)));
		Исключение
			Итог = Новый Соответствие;
			Итог.Вставить("error",   "InvalidUID");
			Итог.Вставить("message", "Неверный формат user_uid: " + УИДСтрока);
			Итог.Вставить("hint",    "Ожидается UUID 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'.");
			Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
		КонецПопытки;
	КонецЕсли;

	// В БИТ.ФИНАНС группы доступа часто создаются персонально под пользователя,
	// поэтому одно наименование может встречаться тысячи раз (напр. 3235 групп
	// «БИТ.Исполнитель казначейства»). Без агрегации выдача была бы бесполезной:
	// N одинаковых строк. Группируем по паре «наименование + профиль».
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ &&Лимит
	|	ГД.Наименование                         КАК ГруппаНазвание,
	|	ЕСТЬNULL(ГД.Профиль.Наименование, """") КАК Профиль,
	|	МАКСИМУМ(ГД.Профиль)                    КАК ПрофильСсылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГД.Ссылка)         КАК ЭкземпляровГруппы
	|ИЗ
	|	Справочник.ГруппыДоступа КАК ГД
	|ГДЕ
	|	НЕ ГД.ПометкаУдаления
	|	И (&БезФильтраИмени ИЛИ ГД.Наименование ПОДОБНО &ШаблонИмени)
	|	И (&БезФильтраПольз ИЛИ ГД.Ссылка В
	|		(ВЫБРАТЬ ТЧ.Ссылка
	|		 ИЗ Справочник.ГруппыДоступа.Пользователи КАК ТЧ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК П
	|			ПО П.Ссылка = ТЧ.Пользователь
	|		 ГДЕ П.ИдентификаторПользователяИБ = &УИД))
	|СГРУППИРОВАТЬ ПО
	|	ГД.Наименование,
	|	ЕСТЬNULL(ГД.Профиль.Наименование, """")
	|УПОРЯДОЧИТЬ ПО
	|	ГД.Наименование";

	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "&&Лимит", Формат(Лимит, "ЧГ=0")));
	Запрос.УстановитьПараметр("БезФильтраИмени", Не ЗначениеЗаполнено(ИмяГруппы));
	Запрос.УстановитьПараметр("ШаблонИмени",     "%" + ИмяГруппы + "%");
	Запрос.УстановитьПараметр("БезФильтраПольз", Не ФильтрПоПользователю);
	Запрос.УстановитьПараметр("УИД",             УИДЗначение);

	ТаблицаГрупп = Запрос.Выполнить().Выгрузить();

	Если ТаблицаГрупп.Количество() = 0 Тогда
		Итог = Новый Соответствие;
		Итог.Вставить("groups_count", 0);
		Итог.Вставить("groups",       Новый Массив);
		Итог.Вставить("message",      "Группы доступа не найдены по заданным условиям.");
		Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);
	КонецЕсли;

	МассивИмён = ТаблицаГрупп.ВыгрузитьКолонку("ГруппаНазвание");

	// Количество уникальных участников по имени группы — одним запросом.
	// Считаем РАЗЛИЧНЫЕ, чтобы один сотрудник, состоящий в нескольких
	// одноимённых группах, не учитывался дважды.
	ЗапросСчёт = Новый Запрос(
	"ВЫБРАТЬ
	|	ГД.Наименование                        КАК ГруппаНазвание,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТЧ.Пользователь)  КАК Участников
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГД
	|		ПО ГД.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	ГД.Наименование В (&МассивИмён)
	|	И НЕ ГД.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	ГД.Наименование");
	ЗапросСчёт.УстановитьПараметр("МассивИмён", МассивИмён);
	ТаблицаСчёт = ЗапросСчёт.Выполнить().Выгрузить();

	СчётМап = Новый Соответствие;
	Для Каждого Стр Из ТаблицаСчёт Цикл
		СчётМап.Вставить(Стр.ГруппаНазвание, Стр.Участников);
	КонецЦикла;

	// Роли профилей — одним запросом, если запрошено
	РолиМап = Новый Соответствие;
	Если ВклРоли Тогда
		МассивПрофилей = Новый Массив;
		Для Каждого Стр Из ТаблицаГрупп Цикл
			Если ЗначениеЗаполнено(Стр.ПрофильСсылка)
				И МассивПрофилей.Найти(Стр.ПрофильСсылка) = Неопределено Тогда
				МассивПрофилей.Добавить(Стр.ПрофильСсылка);
			КонецЕсли;
		КонецЦикла;

		Если МассивПрофилей.Количество() > 0 Тогда
			Попытка
				ЗапросРолей = Новый Запрос(
				"ВЫБРАТЬ
				|	ТЧР.Ссылка КАК ПрофильСсылка,
				|	ТЧР.Роль   КАК Роль
				|ИЗ
				|	Справочник.ПрофилиГруппДоступа.Роли КАК ТЧР
				|ГДЕ
				|	ТЧР.Ссылка В (&МассивПрофилей)");
				ЗапросРолей.УстановитьПараметр("МассивПрофилей", МассивПрофилей);
				ТаблицаРолей = ЗапросРолей.Выполнить().Выгрузить();

				Для Каждого Стр Из ТаблицаРолей Цикл
					СписокРолей = РолиМап[Стр.ПрофильСсылка];
					Если СписокРолей = Неопределено Тогда
						СписокРолей = Новый Массив;
						РолиМап.Вставить(Стр.ПрофильСсылка, СписокРолей);
					КонецЕсли;
					СписокРолей.Добавить(Строка(Стр.Роль));
				КонецЦикла;
			Исключение
				// Состав ролей недоступен в этой конфигурации — не критично
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Массив = Новый Массив;
	Для Каждого Стр Из ТаблицаГрупп Цикл
		Мап = Новый Соответствие;
		Мап.Вставить("group",         Стр.ГруппаНазвание);
		Мап.Вставить("profile",       Стр.Профиль);
		Мап.Вставить("members_count", ?(СчётМап[Стр.ГруппаНазвание] = Неопределено,
		                                0, СчётМап[Стр.ГруппаНазвание]));
		// Сколько физических экземпляров группы с таким именем в справочнике.
		// >1 означает персональные группы доступа под каждого сотрудника.
		Мап.Вставить("group_instances", Стр.ЭкземпляровГруппы);
		Если ВклРоли Тогда
			Мап.Вставить("roles", ?(РолиМап[Стр.ПрофильСсылка] = Неопределено,
			                        Новый Массив, РолиМап[Стр.ПрофильСсылка]));
		КонецЕсли;
		Массив.Добавить(Мап);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("groups_count", Массив.Количество());
	Итог.Вставить("groups",       Массив);
	Итог.Вставить("privacy_note",
		"ФИО участников не передаётся — только количество."
		+ " Строки агрегированы по имени группы: group_instances показывает,"
		+ " сколько физических групп с таким именем в справочнике.");
	Возврат mcp_ОбщегоНазначения.ЗначениеВJSON(Итог);

КонецФункции

