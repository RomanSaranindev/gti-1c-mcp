Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ДобавитьИнструментСписокМетаданных(Инструменты);
	ДобавитьИнструментСтруктураОбъекта(Инструменты);
	ЗарегистрироватьИнструментыGetVisaRoutes(Инструменты);
	ЗарегистрироватьИнструментExecuteQuery(Инструменты);
	ЗарегистрироватьИнструментGetUserRights(Инструменты);
	ЗарегистрироватьИнструментGetUserVisas(Инструменты);
	ЗарегистрироватьИнструментGetUsers(Инструменты);
	ЗарегистрироватьИнструментGetAccessGroups(Инструменты);
	ЗарегистрироватьИнструментGetDocuments(Инструменты);
	ЗарегистрироватьИнструментCheckDocumentAccess(Инструменты);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

    Если ИмяИнструмента = "list_metadata_objects" Тогда
        Возврат СписокМетаданных(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_metadata_structure" Тогда
        Возврат СтруктураОбъектаМетаданных(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_visa_routes" Тогда
        Возврат ВыполнитьGetVisaRoutes(Аргументы);
    ИначеЕсли ИмяИнструмента = "execute_query" Тогда
        Возврат ВыполнитьЗапросПоТексту(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_user_rights" Тогда
        Возврат ВыполнитьGetUserRights(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_user_visas" Тогда
        Возврат ВыполнитьGetUserVisas(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_users" Тогда
        Возврат ВыполнитьGetUsers(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_access_groups" Тогда
        Возврат ВыполнитьGetAccessGroups(Аргументы);
    ИначеЕсли ИмяИнструмента = "get_documents" Тогда
        Возврат ВыполнитьGetDocuments(Аргументы);
    ИначеЕсли ИмяИнструмента = "check_document_access" Тогда
        Возврат ВыполнитьCheckDocumentAccess(Аргументы);
    Иначе
        ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;
    КонецЕсли;

КонецФункции

