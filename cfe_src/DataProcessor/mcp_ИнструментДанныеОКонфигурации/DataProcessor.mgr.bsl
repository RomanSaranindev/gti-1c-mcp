	// Параметр metaType - тип объекта метаданных (только те, у которых есть структура)
	СписокТиповМетаданных = "Catalogs,Documents,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,Reports,DataProcessors,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans,Enums";

	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"metaType",
		"string",
		"Тип объекта метаданных",
		,
		Истина,
		СписокТиповМетаданных
	));

	// Параметр name - точное имя объекта (не зависимое от регистра)
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name",
		"string",
		"Точное имя объекта метаданных (без учета регистра)",
		,
		Истина
	));

	// Параметр sections - массив секций для вывода
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструментаМассив(
		"sections",
		"string",
		"Секции вывода. fields=поля (стандартные+реквизиты+измерения+ресурсы), tabular_sections=ТЧ, predefined=предопределенные, owners=владельцы, register_records=регистры движений (только для документов), subsystems=подсистемы прямого вхождения. По умолчанию все, кроме predefined и subsystems. Для Enums применяется только subsystems.",
		,
		ДопустимыеСекции()
	));

	// Параметр maxTypesInComposite - лимит типов для составного реквизита
	МассивПараметров.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"maxTypesInComposite",
		"number",
		"Лимит типов составного реквизита (0 - без лимита)",
		10
	));

	// Создаем JSON-схему параметров
	СхемаПараметров = mcp_Метаданные.СхемаПараметровИнструмента(МассивПараметров);

	// Добавляем инструмент в таблицу
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_metadata_structure",
		"Структура объекта метаданных: поля, ТЧ, владельцы, предопределенные, значения перечисления. Для документов — список регистров движений. Опционально (секция subsystems) — список подсистем объекта.",
		СхемаПараметров
	);

КонецПроцедуры

Функция СтруктураОбъектаМетаданных(Аргументы)

	МетаТип = Аргументы.metaType;
	ИмяОбъекта = Аргументы.name;

	// Получаем коллекцию нужного типа
	Попытка
		КоллекцияМД = Метаданные[МетаТип];
	Исключение
		ВызватьИсключение "Неизвестный тип метаданных в metaType: " + МетаТип;
	КонецПопытки;

	// Ищем объект метаданных по имени (без учета регистра)
	МетаданныеОбъекта = КоллекцияМД.Найти(ИмяОбъекта);
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Объект метаданных не найден: " + МетаТип + "." + ИмяОбъекта;
	КонецЕсли;

	// Разбор параметра sections: Неопределено = поведение по умолчанию (все секции, кроме predefined)
	Секции = Неопределено;
	Если Аргументы.Свойство("sections") И ТипЗнч(Аргументы.sections) = Тип("Массив") Тогда
		ДопустимыеЗначения = СтрРазделить(ДопустимыеСекции(), ",", Ложь);
		Для Каждого ИмяСекции Из Аргументы.sections Цикл
			Если ДопустимыеЗначения.Найти(ИмяСекции) = Неопределено Тогда
				ВызватьИсключение "Недопустимое имя секции: " + ИмяСекции
					+ ". Допустимые значения: " + СтрСоединить(ДопустимыеЗначения, ", ");
			КонецЕсли;
		КонецЦикла;
		Секции = Аргументы.sections;
	КонецЕсли;

	// Разбор параметра maxTypesInComposite
	МаксТиповВСоставном = ?(Аргументы.Свойство("maxTypesInComposite"), Аргументы.maxTypesInComposite, 10);

	ОбработкаОбъект = Создать();

	Возврат ОбработкаОбъект.ОписаниеСтруктурыОбъектаМетаданных(МетаданныеОбъекта, Секции, МаксТиповВСоставном);

КонецФункции

// Список допустимых значений параметра sections инструмента get_metadata_structure.
// Используется и при регистрации схемы параметра, и при валидации входа.
//
Функция ДопустимыеСекции()
	Возврат "fields,tabular_sections,predefined,owners,register_records,subsystems";
КонецФункции

